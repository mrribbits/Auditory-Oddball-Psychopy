    </Routine>
    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="instruct" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="vpixxSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the start&amp;#10;#               dialog appears and before the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: loads VPixx's Python library, pypixxlib.&amp;#10;#&amp;#10;# WHAT THE DATAPixx3 DOES IN THIS EXPERIMENT:&amp;#10;#   The DATAPixx3 is VPixx's box that sits between the stimulus PC and&amp;#10;#   the projector. Here it has two jobs:&amp;#10;#     1. MEG TRIGGERS. It reads the colour of the top-left screen pixel&amp;#10;#        at every screen refresh and sends it to the MEG as a trigger&amp;#10;#        number (&quot;Pixel Mode&quot;). See triggerSetup.&amp;#10;#     2. SOUND. It plays the standard and deviant tones from its own&amp;#10;#        memory, started exactly at a screen refresh, which the PC's&amp;#10;#        sound card can't do. See toneSetup.&amp;#10;#&amp;#10;# WHY THESE COMPONENTS ARE IN THE instruct ROUTINE:&amp;#10;#   A code component has to live in some routine. The &quot;Experiment&quot; tabs&amp;#10;#   (Before Experiment, Begin Experiment) run once per session, no&amp;#10;#   matter which routine they are in.&amp;#10;#   The four VPixx/sequence components must stay in this order:&amp;#10;#   vpixxSetup, triggerSetup, toneSetup, sequenceGen. Builder runs their&amp;#10;#   code top to bottom, and the later ones use names made earlier.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Load the VPixx library -----------------------------------------&amp;#10;# try / except ImportError means: try to load pypixxlib, and if it isn't&amp;#10;# installed on this computer, carry on without it. The Begin Experiment&amp;#10;# tab then switches to dummy mode (no DATAPixx3).&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as dp&amp;#10;    pypixxlibInstalled = True&amp;#10;except ImportError:&amp;#10;    dp = None&amp;#10;    pypixxlibInstalled = False&amp;#10;&amp;#10;# &quot;atexit&quot; lets us name a function that must run when the program closes,&amp;#10;# however it closes (see Begin Experiment).&amp;#10;import atexit&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the start dialog closes and the window&amp;#10;#               opens, before the first routine starts.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. decides between the real DATAPixx3 and dummy mode&amp;#10;#   2. stops the run if the window is not full screen (unless dummy)&amp;#10;#   3. connects to the DATAPixx3&amp;#10;#   4. makes sure the DATAPixx3 is released when the experiment ends&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. Real DATAPixx3 or dummy mode? --------------------------------&amp;#10;# The &quot;Use dummy VPIXX?&quot; dropdown in the start dialog runs the&amp;#10;# experiment without a DATAPixx3, for testing on any computer: no MEG&amp;#10;# triggers, and the tones play through PsychoPy instead (not precisely&amp;#10;# timed). .get() with default 'no' keeps us safe if the dialog field&amp;#10;# somehow isn't present; the pypixxlib-not-installed auto-force below&amp;#10;# still works either way.&amp;#10;DUMMY_VPIXX = str(expInfo.get('Use dummy VPIXX?', 'no')).lower() == 'yes'&amp;#10;&amp;#10;# Without pypixxlib we can't talk to a DATAPixx3, so force dummy mode&amp;#10;# and print a loud warning in the Runner window.&amp;#10;if not pypixxlibInstalled and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib is not installed, so dummy VPIXX mode was '&amp;#10;                    'turned on: NO MEG TRIGGERS, and tones are NOT precisely '&amp;#10;                    'timed')&amp;#10;    DUMMY_VPIXX = True&amp;#10;&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;# ---- 2. Stop if the window is not full screen ------------------------&amp;#10;# The DATAPixx3 reads the top-left pixel of the whole SCREEN. If our&amp;#10;# window is smaller than the screen, that pixel belongs to the desktop.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    message = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN '&amp;#10;               'mode. Switch Builder from Pilot to Run, or pick &quot;yes&quot; for '&amp;#10;               '&quot;Use dummy VPIXX?&quot; in the start dialog to test without the '&amp;#10;               'DATAPixx3.')&amp;#10;    logging.error(message)&amp;#10;    raise RuntimeError(message)&amp;#10;&amp;#10;# ---- 3. Connect to the DATAPixx3 -------------------------------------&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxOpen()                   # connect over USB&amp;#10;    dp.DPxStopAllScheds()          # stop anything an earlier run left playing&amp;#10;    # Pixel Mode OFF for now. EyeLink calibration and the drift check&amp;#10;    # draw their own screens, and their colours must not reach the MEG&amp;#10;    # as triggers. The triggersOn routine switches it on after the&amp;#10;    # drift check.&amp;#10;    dp.DPxDisableDoutPixelMode()&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;&amp;#10;# ---- 4. Release the DATAPixx3 when the experiment ends ----------------&amp;#10;def closeVpixx():&amp;#10;    &quot;&quot;&quot;Stop sound, switch Pixel Mode off, disconnect.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    try:&amp;#10;        dp.DPxStopAllScheds()&amp;#10;        dp.DPxDisableDoutPixelMode()&amp;#10;        dp.DPxWriteRegCache()&amp;#10;        dp.DPxClose()&amp;#10;    except Exception:&amp;#10;        pass&amp;#10;&amp;#10;# atexit.register asks Python to run closeVpixx when the program ends.&amp;#10;atexit.register(closeVpixx)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="vpixxSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="triggerSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# triggerSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the&amp;#10;#               window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: defines the trigger colours for this oddball paradigm.&amp;#10;#&amp;#10;# HOW PIXEL MODE TRIGGERS WORK (read this first):&amp;#10;#   Each time the screen refreshes (120 times per second here) the&amp;#10;#   DATAPixx3 looks at ONE pixel: the very top-left pixel of the screen.&amp;#10;#   In &quot;Pixel Mode B&quot; it reads that pixel's BLUE value (0 to 255) and&amp;#10;#   puts it out on 8 digital lines, which are recorded on the MEG&amp;#10;#   trigger channel. Red and green are ignored, so we keep them at 0.&amp;#10;#&amp;#10;#   Each of these blue values switches on exactly ONE of the 8 lines:&amp;#10;#       1, 2, 4, 8, 16, 32, 64, 128&amp;#10;#   Blue = 0 (a black pixel) means all lines are off.&amp;#10;#&amp;#10;#   So to &quot;send trigger 2&quot; we colour that one pixel (0, 0, 2) for one&amp;#10;#   frame, then make it black again. The pixel is too dark to see.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- The trigger colours used in this experiment --------------------&amp;#10;TRIG_STANDARD    = (0, 0,  1)   # standard tone onset        -&gt; MEG trigger 1&amp;#10;TRIG_DEVIANT     = (0, 0,  2)   # deviant tone onset         -&gt; MEG trigger 2&amp;#10;TRIG_BLINK       = (0, 0,  4)   # BLINK cue onset            -&gt; MEG trigger 4&amp;#10;TRIG_CUE_LEFT    = (0, 0,  8)   # left-hand cue arrows       -&gt; MEG trigger 8&amp;#10;TRIG_CUE_RIGHT   = (0, 0, 16)   # right-hand cue arrows      -&gt; MEG trigger 16&amp;#10;TRIG_FEEDBACK    = (0, 0, 32)   # MISS or WRONG BUTTON       -&gt; MEG trigger 32&amp;#10;TRIG_OFF         = (0, 0,  0)   # black pixel                -&gt; all lines off&amp;#10;&amp;#10;# Unused values on the 8-line channel: 64 and 128. Reserved for future&amp;#10;# event markers if the paradigm grows.&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# triggerSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the window opens, straight after vpixxSetup.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. creates the 1x1 trigger pixel in the top-left corner&amp;#10;#   2. defines the functions that colour it, send triggers and read the&amp;#10;#      DATAPixx3's clock&amp;#10;#&amp;#10;# Pixel Mode itself is switched on later, by the triggersOn routine&amp;#10;# after the drift check, and off on the thanks screen.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. The trigger pixel --------------------------------------------&amp;#10;screenWidthPix, screenHeightPix = win.size&amp;#10;triggerPixel = visual.Rect(&amp;#10;    win,&amp;#10;    units='pix',&amp;#10;    width=1,&amp;#10;    height=1,&amp;#10;    pos=(-screenWidthPix / 2 + 0.5, screenHeightPix / 2 - 0.5),&amp;#10;    colorSpace='rgb255',&amp;#10;    fillColor=TRIG_OFF,&amp;#10;    lineColor=TRIG_OFF,&amp;#10;    lineWidth=0,&amp;#10;    interpolate=False,&amp;#10;    autoLog=False,&amp;#10;)&amp;#10;triggerPixel.setAutoDraw(True)&amp;#10;&amp;#10;&amp;#10;# ---- 2. Functions used by the other components -----------------------&amp;#10;def setTriggerPixel(colour):&amp;#10;    &quot;&quot;&quot;Give the trigger pixel a new colour. Change appears at next refresh.&quot;&quot;&quot;&amp;#10;    triggerPixel.fillColor = colour&amp;#10;    triggerPixel.lineColor = colour&amp;#10;&amp;#10;&amp;#10;# Per-trial VPIXX-clock timestamps, looked up by name, e.g.&amp;#10;# vpixxTimes['deviant']. trialLog copies them into the trial log.&amp;#10;vpixxTimes = {}&amp;#10;&amp;#10;&amp;#10;def recordVpixxTime(stimName):&amp;#10;    &quot;&quot;&quot;Save the DATAPixx3's own clock as the column stimName + '_vp'.&amp;#10;    sendTrigger() queues this to run straight after the refresh that&amp;#10;    showed the trigger, so the time marks that refresh.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        vpixxTimes[stimName] = None&amp;#10;        return&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    vpixxTimes[stimName] = dp.DPxGetTime()&amp;#10;&amp;#10;&amp;#10;def sendTrigger(colour, stimName):&amp;#10;    &quot;&quot;&quot;Show a trigger colour on the next screen refresh and log it.&amp;#10;    colour   : one of the TRIG_ values, e.g. TRIG_DEVIANT&amp;#10;    stimName : short name, e.g. 'deviant'; the trial log stores its&amp;#10;               VPIXX-clock timestamp as stimName + '_vp'.&quot;&quot;&quot;&amp;#10;    setTriggerPixel(colour)&amp;#10;    # win.callOnFlip(function, argument) runs the function straight&amp;#10;    # after the next screen refresh, the one that shows this trigger.&amp;#10;    win.callOnFlip(recordVpixxTime, stimName)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="triggerSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="toneSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# toneSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the&amp;#10;#               window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the tone parameters and makes both tones (standard&amp;#10;#               and deviant).&amp;#10;#&amp;#10;# HOW THE SOUND IS PLAYED (read this first):&amp;#10;#   The tones are played by the DATAPixx3, not the stimulus PC's sound&amp;#10;#   card. The DATAPixx3 has its own memory and its own audio output.&amp;#10;#     1. At the start of the experiment we copy BOTH tones, once, into&amp;#10;#        the DATAPixx3's memory (Begin Experiment tab).&amp;#10;#     2. Each tone's trial-time play is set up in tone's trialSetup:&amp;#10;#        we give the DATAPixx3 an audio schedule saying &quot;play buffer at&amp;#10;#        standardAddress&quot; or &quot;play buffer at deviantAddress&quot;, mono.&amp;#10;#     3. On the frame the tone should start, we tell it &quot;start&quot;, timed&amp;#10;#        to arrive exactly when the screen refreshes.&amp;#10;# ======================================================================&amp;#10;&amp;#10;import numpy as np&amp;#10;&amp;#10;# ---- Tone parameters -------------------------------------------------&amp;#10;standardFreqHz   = 1000         # standard tone pitch (Hz)&amp;#10;deviantFreqHz    = 1200         # deviant tone pitch (Hz)&amp;#10;toneDurationSec  = 0.400        # both tones 400 ms&amp;#10;rampSec          = 0.010        # 10 ms fade-in/out (avoids clicks)&amp;#10;sampleRate       = 48000        # DATAPixx3 audio sample rate&amp;#10;toneLoudness     = 0.8          # 0 to 1&amp;#10;audioVolume      = 0.5          # DATAPixx3 output volume, both ears&amp;#10;&amp;#10;# Buffer addresses in the DATAPixx3's audio RAM. 16,000,000 is the&amp;#10;# address VPixx uses by default; put the deviant 0.5 MB later.&amp;#10;standardAddress  = 16_000_000&amp;#10;deviantAddress   = 16_500_000&amp;#10;&amp;#10;&amp;#10;def _make_tone(freqHz, duration_s, ramp_s, sample_rate, loudness):&amp;#10;    &quot;&quot;&quot;Build an int16 pure tone with cosine fade-in/out.&quot;&quot;&quot;&amp;#10;    nSamples = int(round(duration_s * sample_rate))&amp;#10;    t = np.arange(nSamples) / sample_rate&amp;#10;    wave = np.sin(2 * np.pi * freqHz * t)&amp;#10;    nRamp = int(round(ramp_s * sample_rate))&amp;#10;    fade = 0.5 * (1 - np.cos(np.pi * np.arange(nRamp) / nRamp))&amp;#10;    wave[:nRamp] = wave[:nRamp] * fade&amp;#10;    wave[-nRamp:] = wave[-nRamp:] * fade[::-1]&amp;#10;    return (wave * loudness * 32767).astype(np.int16)&amp;#10;&amp;#10;&amp;#10;standardWave = _make_tone(standardFreqHz, toneDurationSec,&amp;#10;                          rampSec, sampleRate, toneLoudness)&amp;#10;deviantWave  = _make_tone(deviantFreqHz,  toneDurationSec,&amp;#10;                          rampSec, sampleRate, toneLoudness)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# toneSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the window opens, straight after vpixxSetup&amp;#10;#               and triggerSetup.&amp;#10;#&amp;#10;# WHAT IT DOES: turns the DATAPixx3's audio on and copies BOTH tones&amp;#10;#               into its memory. In dummy mode (no DATAPixx3) it&amp;#10;#               prepares ordinary PsychoPy sounds instead.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    # ---- Real DATAPixx3 ----------------------------------------------&amp;#10;    dp.DPxInitAudCodec()&amp;#10;    # Device opens at volume 0 (silent) every time, so set it here.&amp;#10;    dp.DPxSetAudLeftVolume(audioVolume)&amp;#10;    dp.DPxSetAudRightVolume(audioVolume)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;    # Copy both tones into memory, each at its own address.&amp;#10;    dp.DPxWriteAudioBuffer(standardWave, standardAddress)&amp;#10;    dp.DPxWriteAudioBuffer(deviantWave,  deviantAddress)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;    logging.exp('DATAPixx3 audio ready: standard %d samples, deviant %d samples'&amp;#10;                % (len(standardWave), len(deviantWave)))&amp;#10;&amp;#10;else:&amp;#10;    # ---- Dummy mode: use PsychoPy sound instead ----------------------&amp;#10;    # Timing is approximate (OS audio latency); use dummy mode for&amp;#10;    # testing only. PsychoPy's sounddevice backend expects a 2D array&amp;#10;    # (samples x channels), so we duplicate the mono tone across two&amp;#10;    # stereo channels via column_stack.&amp;#10;    _standard_float = standardWave.astype(np.float32) / 32767.0&amp;#10;    _deviant_float  = deviantWave.astype(np.float32) / 32767.0&amp;#10;    standardSound = sound.Sound(&amp;#10;        np.column_stack([_standard_float, _standard_float]),&amp;#10;        sampleRate=sampleRate, stereo=True,&amp;#10;    )&amp;#10;    deviantSound  = sound.Sound(&amp;#10;        np.column_stack([_deviant_float, _deviant_float]),&amp;#10;        sampleRate=sampleRate, stereo=True,&amp;#10;    )&amp;#10;&amp;#10;&amp;#10;def prep_tone_schedule(kind):&amp;#10;    &quot;&quot;&quot;Set the DATAPixx3's audio schedule to play one tone (standard&amp;#10;    or deviant) in mono on the next 'start'. Call BEFORE arming&amp;#10;    DPxStartAudSched + DPxWriteRegCacheAfterVideoSync.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    if kind == 'deviant':&amp;#10;        addr, nSamp = deviantAddress, len(deviantWave)&amp;#10;    else:&amp;#10;        addr, nSamp = standardAddress, len(standardWave)&amp;#10;    # 'mono' sends the buffer to both ears.&amp;#10;    dp.DPxSetAudioSchedule(0.0, sampleRate, nSamp, 'mono', addr)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="toneSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="sequenceGen" plugin="None">
        <Param val="# ======================================================================&amp;#10;# sequenceGen  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Module-level imports. They must live here (not in Begin Routine or&amp;#10;# Begin Experiment), because Builder wraps those tabs inside the main&amp;#10;# run() function -- putting `import os` there turns `os` into a local&amp;#10;# variable, which crashes Builder's own `os.chdir(_thisDir)` call that&amp;#10;# runs earlier in run().&amp;#10;# ======================================================================&amp;#10;import csv&amp;#10;import json&amp;#10;import os&amp;#10;import random&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# sequenceGen  |  &quot;Begin Routine&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the instructions screen first appears&amp;#10;#               (before any trials have run).&amp;#10;#&amp;#10;# WHAT IT DOES: generates fresh randomized trial sequences for this&amp;#10;#               session and writes them to CSV files that the Builder&amp;#10;#               loops read from.&amp;#10;#&amp;#10;#   One CSV for the training block (20 trials)&amp;#10;#   One CSV per main block (3 x 100 trials)&amp;#10;#&amp;#10;#   Each CSV row describes a single trial:&amp;#10;#     cue_hand         'left' or 'right' (which hand to prepare)&amp;#10;#     expected_button  '7' or '2' (what finger counts as correct)&amp;#10;#     n_standards      3-7 (number of standard tones before deviant)&amp;#10;#     isis_json        JSON list of ISIs between consecutive tones&amp;#10;#     is_training      True for the training CSV, False for the 3 main&amp;#10;#&amp;#10;#   Randomization:&amp;#10;#     cue_hand balanced 50/50 and shuffled within each block&amp;#10;#     n_standards drawn uniformly from [MIN_STANDARDS, MAX_STANDARDS]&amp;#10;#     ISIs drawn uniformly from [ISI_MIN, ISI_MAX]&amp;#10;#&amp;#10;# WHY GENERATE FRESH EACH SESSION (rather than committing fixed CSVs&amp;#10;# to the repo): different subjects should see different sequences to&amp;#10;# avoid order effects contaminating group analyses.&amp;#10;#&amp;#10;# WHY HERE (not Begin Experiment):&amp;#10;#   We need expInfo['participant'] and expInfo['session'] to name the&amp;#10;#   CSV files (so a session's conditions files live alongside its data&amp;#10;#   files in results/). Those fields are only populated AFTER the&amp;#10;#   start dialog closes, so this must run in the Begin Routine of the&amp;#10;#   first user-facing routine -- not Begin Experiment, which fires&amp;#10;#   before the dialog.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   expInfo, thisExp - Builder (participant info; data file name base)&amp;#10;#   csv, json, os,&amp;#10;#   random           - sequenceGen Before Experiment (module imports)&amp;#10;#   logging          - PsychoPy (available everywhere)&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Design parameters (edit here) -----------------------------------&amp;#10;N_TRAINING_TRIALS   = 20&amp;#10;N_MAIN_TRIALS       = 100&amp;#10;N_BLOCKS            = 3&amp;#10;MIN_STANDARDS       = 3    # min standards before each deviant&amp;#10;MAX_STANDARDS       = 7    # max standards before each deviant&amp;#10;ISI_MIN             = 0.700&amp;#10;ISI_MAX             = 0.900&amp;#10;&amp;#10;# ---- Session results folder ------------------------------------------&amp;#10;# Builder sets thisExp.dataFileName to the base path for its own output&amp;#10;# files (no extension). We write our conditions CSVs next to those.&amp;#10;_results_dir = os.path.dirname(thisExp.dataFileName)&amp;#10;if _results_dir and not os.path.isdir(_results_dir):&amp;#10;    os.makedirs(_results_dir, exist_ok=True)&amp;#10;_base_name = os.path.basename(thisExp.dataFileName)&amp;#10;&amp;#10;&amp;#10;def _generate_block(n_trials, is_training_flag, seed=None):&amp;#10;    &quot;&quot;&quot;Make one block's trial list.&amp;#10;&amp;#10;    cue_hand is balanced 50/50 and shuffled.&amp;#10;    n_standards is drawn uniformly from [MIN_STANDARDS, MAX_STANDARDS].&amp;#10;    ISIs are drawn uniformly from [ISI_MIN, ISI_MAX], one per standard&amp;#10;    tone (the deviant has none after it).&amp;#10;&amp;#10;    is_training_flag is written as a column so trial code can tell&amp;#10;    which outer loop it is in (there are two tone_loops with&amp;#10;    different names, one per outer loop; see tonePresent).&amp;#10;    &quot;&quot;&quot;&amp;#10;    rng = random.Random(seed)&amp;#10;    half = n_trials // 2&amp;#10;    hands = ['left'] * half + ['right'] * (n_trials - half)&amp;#10;    rng.shuffle(hands)&amp;#10;    trials = []&amp;#10;    for hand in hands:&amp;#10;        n_std = rng.randint(MIN_STANDARDS, MAX_STANDARDS)&amp;#10;        # One ISI per standard (deviant tone comes last, no ISI after)&amp;#10;        isis = [round(rng.uniform(ISI_MIN, ISI_MAX), 4) for _ in range(n_std)]&amp;#10;        trials.append({&amp;#10;            'cue_hand':        hand,&amp;#10;            'expected_button': '1' if hand == 'left' else '2',&amp;#10;            'n_standards':     n_std,&amp;#10;            'isis_json':       json.dumps(isis),&amp;#10;            'is_training':     is_training_flag,&amp;#10;        })&amp;#10;    return trials&amp;#10;&amp;#10;&amp;#10;def _write_conditions_csv(path, trials):&amp;#10;    &quot;&quot;&quot;Write a Builder-compatible conditions CSV.&quot;&quot;&quot;&amp;#10;    fieldnames = ['cue_hand', 'expected_button', 'n_standards',&amp;#10;                  'isis_json', 'is_training']&amp;#10;    with open(path, 'w', newline='') as f:&amp;#10;        w = csv.DictWriter(f, fieldnames=fieldnames)&amp;#10;        w.writeheader()&amp;#10;        w.writerows(trials)&amp;#10;&amp;#10;&amp;#10;# Fresh random seed each session (different subjects get different&amp;#10;# sequences). The seed is recorded in the data file so a run can be&amp;#10;# reproduced if needed.&amp;#10;_session_seed = random.randrange(2**31)&amp;#10;thisExp.addData('session_seed', _session_seed)&amp;#10;_seed_rng = random.Random(_session_seed)&amp;#10;&amp;#10;# ---- Training block --------------------------------------------------&amp;#10;training_csv = os.path.join(_results_dir, _base_name + '_training.csv')&amp;#10;_write_conditions_csv(training_csv,&amp;#10;                      _generate_block(N_TRAINING_TRIALS,&amp;#10;                                      is_training_flag=True,&amp;#10;                                      seed=_seed_rng.randrange(2**31)))&amp;#10;&amp;#10;# ---- Main blocks: one CSV per block ----------------------------------&amp;#10;# A list of per-block CSV paths, used by the block loop below.&amp;#10;block_csvs = []&amp;#10;for b in range(1, N_BLOCKS + 1):&amp;#10;    path = os.path.join(_results_dir,&amp;#10;                        _base_name + f'_block{b}.csv')&amp;#10;    _write_conditions_csv(path, _generate_block(&amp;#10;        N_MAIN_TRIALS, is_training_flag=False,&amp;#10;        seed=_seed_rng.randrange(2**31)))&amp;#10;    block_csvs.append(path)&amp;#10;&amp;#10;logging.exp(f'Generated conditions: training={training_csv}')&amp;#10;for i, p in enumerate(block_csvs, 1):&amp;#10;    logging.exp(f'Generated conditions: block {i}={p}')&amp;#10;&amp;#10;# ---- Running counts for progress and summary -------------------------&amp;#10;overall_trial     = 0        # bumped at the start of every trial&amp;#10;training_results  = []       # list of outcome strings&amp;#10;main_results      = []       # list of (block, outcome) tuples&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="sequenceGen" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="responseClassifySetup" plugin="None">
        <Param val="# Module-level import; see sequenceGen's Before Experiment for why.&amp;#10;from psychopy.hardware import keyboard&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# responseClassifySetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts (after the window&amp;#10;#               opens, before the first trial).&amp;#10;#&amp;#10;# WHAT IT DOES: creates one Keyboard() object shared across the whole&amp;#10;#               session, and defines the key-to-finger mapping.&amp;#10;#&amp;#10;# WHY A SHARED Keyboard() (not a per-trial one):&amp;#10;#   Each Keyboard() instance maintains its own event buffer. Creating a&amp;#10;#   new one per trial would reset the buffer and we might miss a press&amp;#10;#   that landed in the brief window between the old one being destroyed&amp;#10;#   and the new one listening. Share one and clear/drain it at the&amp;#10;#   right times.&amp;#10;#&amp;#10;# WHY NOT A KeyboardComponent IN THE RESPONSE ROUTINE:&amp;#10;#   PsychoPy's HID keyboard pipeline on Windows needs the OS message&amp;#10;#   queue to be pumped by win.flip() for key presses to be noticed. A&amp;#10;#   KeyboardComponent polls on its own schedule and in some PsychoPy&amp;#10;#   versions misses presses made between frames. Polling kb.getKeys()&amp;#10;#   in our Each Frame code (which runs between flips) is more reliable.&amp;#10;#&amp;#10;# KEY_CODES: edit here if your button box emits different key names.&amp;#10;#   Scully lab convention: '7' = left index, '2' = right index.&amp;#10;#   Common alternatives:&amp;#10;#     Current Designs digit mode: '1'..'4' or '5'..'8'&amp;#10;#     Button-box USB-HID letter mode: 'a', 'b', 'c', 'd'&amp;#10;#   Only entries for 'left_index' and 'right_index' are required for&amp;#10;#   this task. Extra entries (middle, ring, etc.) are logged as&amp;#10;#   &quot;wrong_button&quot; if pressed in the response window.&amp;#10;# ======================================================================&amp;#10;&amp;#10;kb = keyboard.Keyboard()&amp;#10;kb.clearEvents()&amp;#10;&amp;#10;KEY_CODES = {&amp;#10;    '7': 'left_index',&amp;#10;    '2': 'right_index',&amp;#10;}&amp;#10;EXIT_KEY = 'escape'&amp;#10;&amp;#10;# Per-trial event buffer (reset at the start of each response window)&amp;#10;trial_events = []&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="responseClassifySetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="cueSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# cueSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: builds the four cue-arrow TextStims used every trial&amp;#10;#               (two '&lt;' arrows for left trials, two '&gt;' arrows for&amp;#10;#               right trials). We make them ONCE here and reuse them;&amp;#10;#               creating TextStims is slow, so doing it per-trial would&amp;#10;#               introduce timing hiccups.&amp;#10;#&amp;#10;# WHY two TextStims per side (rather than one with text '&lt;   &lt;'):&amp;#10;#   the trigger pixel is driven by a single pixel in the top-left&amp;#10;#   corner, and we want the fixation cross at the exact centre. Using&amp;#10;#   two independent arrows positioned at +/- CUE_ARROW_OFFSET_PX pixels&amp;#10;#   leaves the dead-centre pixel free for the ShapeStim fixation cross&amp;#10;#   drawn by the fixation PolygonComponent in this routine. A single&amp;#10;#   TextStim with embedded spaces would push the arrows a bit off-grid.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   visual, win               - Builder (PsychoPy visual module, main window)&amp;#10;#   CUE_ARROW_OFFSET_PX       - trialTimingSetup Before Experiment tab&amp;#10;# ======================================================================&amp;#10;&amp;#10;cue_left_arrows = [&amp;#10;    visual.TextStim(win, text='&lt;', color='white', height=60,&amp;#10;                    pos=(-CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;    visual.TextStim(win, text='&lt;', color='white', height=60,&amp;#10;                    pos=(+CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;]&amp;#10;cue_right_arrows = [&amp;#10;    visual.TextStim(win, text='&gt;', color='white', height=60,&amp;#10;                    pos=(-CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;    visual.TextStim(win, text='&gt;', color='white', height=60,&amp;#10;                    pos=(+CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;]&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="cueSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="breakSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# breakSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the minimum between-block rest duration. The&amp;#10;#               break screen does not let the experimenter press SPACE&amp;#10;#               until this many seconds have passed, so the subject&amp;#10;#               gets a real break even if the experimenter is&amp;#10;#               impatient.&amp;#10;# ======================================================================&amp;#10;INTERBLOCK_MIN_REST = 15.0   # seconds&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="breakSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="trialTimingSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# trialTimingSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the script starts, before the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: defines all the trial-timing constants. Edit the&amp;#10;#               numbers here (and nowhere else) to change the paradigm.&amp;#10;#               They are referenced from several routines' Stop fields&amp;#10;#               and from scoring code in response_window.&amp;#10;#&amp;#10;# EDITABLE PHASE DURATIONS (seconds):&amp;#10;# ======================================================================&amp;#10;&amp;#10;FIXATION_DURATION   = 1.500      # fixation cross alone (no cue, no tone)&amp;#10;CUE_DURATION        = 0.500      # arrows flank the fixation cross&amp;#10;RESPONSE_WINDOW     = 1.000      # fixation-only phase after the last tone&amp;#10;FEEDBACK_DURATION   = 0.400      # MISS or WRONG BUTTON (error trials only)&amp;#10;BLINK_DURATION      = 0.500      # subject may blink while 'BLINK' is up&amp;#10;&amp;#10;# Tone itself. Needed below to compute the scoring-window upper bound.&amp;#10;TONE_DURATION       = 0.400      # same for standards and the deviant&amp;#10;&amp;#10;# Response-scoring window, in seconds AFTER the deviant tone onset.&amp;#10;# Presses outside this window are logged but not scored as a response.&amp;#10;#   RESP_WIN_MIN: 150 ms floor rejects anticipatory presses that&amp;#10;#     couldn't physically be in reaction to hearing the deviant.&amp;#10;#   RESP_WIN_MAX: deviant duration + response-window phase, matching&amp;#10;#     the FieldTrip reference task.&amp;#10;RESP_WIN_MIN        = 0.150&amp;#10;RESP_WIN_MAX        = TONE_DURATION + RESPONSE_WINDOW   # 1.400 s&amp;#10;&amp;#10;# Cue arrow geometry (pixels from fixation to each arrow's centre).&amp;#10;CUE_ARROW_OFFSET_PX = 50&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialTimingSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="logFilesSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# logFilesSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Module-level imports. Same reason as sequenceGen's Before Experiment:&amp;#10;# imports inside run() would shadow module-level names and crash&amp;#10;# Builder's own code earlier in run().&amp;#10;# ======================================================================&amp;#10;import csv as _csv&amp;#10;import atexit as _atexit_log&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# logFilesSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: opens three TSV files (one row per trial, one row per&amp;#10;#               tone, one row per button press). Each row is flushed&amp;#10;#               to disk after it's written, so a crash doesn't lose&amp;#10;#               completed trials.&amp;#10;#&amp;#10;# COLUMN NAMING CONVENTION (clock provenance):&amp;#10;#   *_pp        PsychoPy default clock (behavioural RT reference)&amp;#10;#   *_vp        VPIXX DATAPixx3 hardware clock (MEG alignment reference)&amp;#10;#   *_vp_est    estimated VPIXX time (derived from a PsychoPy-clock&amp;#10;#               event via the PP&lt;-&gt;VP correspondence sampled at the&amp;#10;#               nearest flip). Accurate to ~one video frame.&amp;#10;# ======================================================================&amp;#10;&amp;#10;_log_base = thisExp.dataFileName&amp;#10;&amp;#10;trials_log_path   = _log_base + '_trials_log.tsv'&amp;#10;tones_log_path    = _log_base + '_tones_log.tsv'&amp;#10;presses_log_path  = _log_base + '_presses_log.tsv'&amp;#10;&amp;#10;trials_log_columns = [&amp;#10;    'overall_trial', 'block', 'trial_in_block', 'is_training',&amp;#10;    'cue_hand', 'expected_button', 'n_standards',&amp;#10;    'fixation_onset_pp', 'fixation_onset_vp',&amp;#10;    'cue_onset_pp',      'cue_onset_vp',&amp;#10;    'first_tone_onset_pp', 'first_tone_onset_vp',&amp;#10;    'deviant_onset_pp',    'deviant_onset_vp',&amp;#10;    'response_button', 'response_key_name',&amp;#10;    'response_time_pp', 'response_time_vp_est',&amp;#10;    'rt_pp', 'rt_vp_est',&amp;#10;    'outcome', 'feedback_shown',&amp;#10;    'blink_onset_pp', 'blink_onset_vp',&amp;#10;    'dummy_vpixx',&amp;#10;]&amp;#10;&amp;#10;tones_log_columns = [&amp;#10;    'overall_trial', 'block', 'trial_in_block', 'tone_index',&amp;#10;    'kind', 'frequency_hz', 'onset_pp', 'onset_vp',&amp;#10;]&amp;#10;&amp;#10;presses_log_columns = [&amp;#10;    'overall_trial', 'block', 'label', 'key_name',&amp;#10;    'time_pp', 'time_vp_est',&amp;#10;]&amp;#10;&amp;#10;_trials_log_fh  = open(trials_log_path,  'w', newline='')&amp;#10;_tones_log_fh   = open(tones_log_path,   'w', newline='')&amp;#10;_presses_log_fh = open(presses_log_path, 'w', newline='')&amp;#10;&amp;#10;trials_log_writer  = _csv.DictWriter(_trials_log_fh,  fieldnames=trials_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;tones_log_writer   = _csv.DictWriter(_tones_log_fh,   fieldnames=tones_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;presses_log_writer = _csv.DictWriter(_presses_log_fh, fieldnames=presses_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;&amp;#10;trials_log_writer.writeheader()&amp;#10;tones_log_writer.writeheader()&amp;#10;presses_log_writer.writeheader()&amp;#10;&amp;#10;for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;    _fh.flush()&amp;#10;&amp;#10;# In-memory per-trial collectors. tone and response routines append&amp;#10;# here; trialLog writes them out at End Routine.&amp;#10;tones_log_rows   = []&amp;#10;presses_log_rows = []&amp;#10;&amp;#10;# Default values used by trialLog's End Routine&amp;#10;block_label      = 'training'   # overwritten in the main block loop&amp;#10;trial_in_block   = 0            # overwritten in each loop&amp;#10;&amp;#10;# Close the files when the program ends.&amp;#10;# (atexit was imported at module level by logFilesSetup's Before Experiment.)&amp;#10;&amp;#10;&amp;#10;def _close_logs():&amp;#10;    for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;        try:&amp;#10;            _fh.close()&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;&amp;#10;&amp;#10;_atexit_log.register(_close_logs)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="logFilesSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="taskStartMsg" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# taskStartMsg  |  &quot;End Routine&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experimenter presses SPACE to leave the&amp;#10;#               instructions screen and begin training.&amp;#10;#&amp;#10;# WHAT IT DOES: writes the message &quot;TASK_START&quot; into the eye-tracking&amp;#10;#               data file (EDF). This acts as a clear marker in the EDF&amp;#10;#               so later analysis can trim to the actual task period&amp;#10;#               and ignore EyeLink calibration / drift-check epochs.&amp;#10;#&amp;#10;# WHERE pylink COMES FROM:&amp;#10;#   The EyeLink Initialize component in the eyelinkSetup routine loads&amp;#10;#   the pylink library. pylink.getEYELINK() returns the shared tracker&amp;#10;#   object, available from any routine.&amp;#10;# ======================================================================&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;el_tracker.sendMessage('TASK_START')&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="taskStartMsg" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="taskInstructions" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="36" valType="num" updates="constant" name="letterHeight"/>
        <Param val="taskInstructions" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="num" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="You will hear a series of tones.&amp;#10;&amp;#10;On each trial an arrow cue appears:&amp;#10;    &lt;  &lt;   = LEFT hand          &gt;  &gt;   = RIGHT hand&amp;#10;&amp;#10;After the cue you will hear several identical tones,&amp;#10;followed by ONE different (higher) tone.&amp;#10;&amp;#10;As soon as you hear the DIFFERENT tone,&amp;#10;press the INDEX FINGER button on the cued hand&amp;#10;as quickly as possible.&amp;#10;&amp;#10;If you miss or press the wrong button, you'll see feedback.&amp;#10;&amp;#10;When 'BLINK' appears, you have half a second to blink.&amp;#10;Otherwise please try not to blink and hold your gaze on the cross.&amp;#10;&amp;#10;Experimenter: press SPACE to start the training block." valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1500" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="ready" plugin="None">
        <Param val="&quot;space&quot;" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="ready" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="num" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="False" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
