    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="instruct" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="vpixxSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the start&amp;#10;#               dialog appears and before the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: loads VPixx's Python library, pypixxlib.&amp;#10;#&amp;#10;# WHAT THE DATAPixx3 DOES IN THIS EXPERIMENT:&amp;#10;#   The DATAPixx3 is VPixx's box that sits between the stimulus PC and&amp;#10;#   the projector. Here it has two jobs:&amp;#10;#     1. MEG TRIGGERS. It reads the colour of the top-left screen pixel&amp;#10;#        at every screen refresh and sends it to the MEG as a trigger&amp;#10;#        number (&quot;Pixel Mode&quot;). See triggerSetup.&amp;#10;#     2. SOUND. It plays the standard and deviant tones from its own&amp;#10;#        memory, started exactly at a screen refresh, which the PC's&amp;#10;#        sound card can't do. See toneSetup.&amp;#10;#&amp;#10;# WHY THESE COMPONENTS ARE IN THE instruct ROUTINE:&amp;#10;#   A code component has to live in some routine. The &quot;Experiment&quot; tabs&amp;#10;#   (Before Experiment, Begin Experiment) run once per session, no&amp;#10;#   matter which routine they are in.&amp;#10;#   The four VPixx/sequence components must stay in this order:&amp;#10;#   vpixxSetup, triggerSetup, toneSetup, sequenceGen. Builder runs their&amp;#10;#   code top to bottom, and the later ones use names made earlier.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Load the VPixx library -----------------------------------------&amp;#10;# try / except ImportError means: try to load pypixxlib, and if it isn't&amp;#10;# installed on this computer, carry on without it. The Begin Experiment&amp;#10;# tab then switches to dummy mode (no DATAPixx3).&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as dp&amp;#10;    pypixxlibInstalled = True&amp;#10;except ImportError:&amp;#10;    dp = None&amp;#10;    pypixxlibInstalled = False&amp;#10;&amp;#10;# &quot;atexit&quot; lets us name a function that must run when the program closes,&amp;#10;# however it closes (see Begin Experiment).&amp;#10;import atexit&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the start dialog closes and the window&amp;#10;#               opens, before the first routine starts.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. decides between the real DATAPixx3 and dummy mode&amp;#10;#   2. stops the run if the window is not full screen (unless dummy)&amp;#10;#   3. connects to the DATAPixx3&amp;#10;#   4. makes sure the DATAPixx3 is released when the experiment ends&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. Real DATAPixx3 or dummy mode? --------------------------------&amp;#10;# The &quot;dummy_vpixx&quot; tick box in the start dialog runs the experiment&amp;#10;# without a DATAPixx3, for testing on any computer: no MEG triggers,&amp;#10;# and the tones play through PsychoPy instead (not precisely timed).&amp;#10;DUMMY_VPIXX = str(expInfo['dummy_vpixx']) == 'True'&amp;#10;&amp;#10;# Without pypixxlib we can't talk to a DATAPixx3, so force dummy mode&amp;#10;# and print a loud warning in the Runner window.&amp;#10;if not pypixxlibInstalled and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib is not installed, so dummy_vpixx was turned '&amp;#10;                    'on: NO MEG TRIGGERS, and tones are NOT precisely timed')&amp;#10;    DUMMY_VPIXX = True&amp;#10;&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;# ---- 2. Stop if the window is not full screen ------------------------&amp;#10;# The DATAPixx3 reads the top-left pixel of the whole SCREEN. If our&amp;#10;# window is smaller than the screen, that pixel belongs to the desktop.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    message = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN '&amp;#10;               'mode. Switch Builder from Pilot to Run, or tick dummy_vpixx '&amp;#10;               'to test without the DATAPixx3.')&amp;#10;    logging.error(message)&amp;#10;    raise RuntimeError(message)&amp;#10;&amp;#10;# ---- 3. Connect to the DATAPixx3 -------------------------------------&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxOpen()                   # connect over USB&amp;#10;    dp.DPxStopAllScheds()          # stop anything an earlier run left playing&amp;#10;    # Pixel Mode OFF for now. EyeLink calibration and the drift check&amp;#10;    # draw their own screens, and their colours must not reach the MEG&amp;#10;    # as triggers. The triggersOn routine switches it on after the&amp;#10;    # drift check.&amp;#10;    dp.DPxDisableDoutPixelMode()&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;&amp;#10;# ---- 4. Release the DATAPixx3 when the experiment ends ----------------&amp;#10;def closeVpixx():&amp;#10;    &quot;&quot;&quot;Stop sound, switch Pixel Mode off, disconnect.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    try:&amp;#10;        dp.DPxStopAllScheds()&amp;#10;        dp.DPxDisableDoutPixelMode()&amp;#10;        dp.DPxWriteRegCache()&amp;#10;        dp.DPxClose()&amp;#10;    except Exception:&amp;#10;        pass&amp;#10;&amp;#10;# atexit.register asks Python to run closeVpixx when the program ends.&amp;#10;atexit.register(closeVpixx)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="vpixxSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="triggerSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# triggerSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the&amp;#10;#               window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: defines the trigger colours for this oddball paradigm.&amp;#10;#&amp;#10;# HOW PIXEL MODE TRIGGERS WORK (read this first):&amp;#10;#   Each time the screen refreshes (120 times per second here) the&amp;#10;#   DATAPixx3 looks at ONE pixel: the very top-left pixel of the screen.&amp;#10;#   In &quot;Pixel Mode B&quot; it reads that pixel's BLUE value (0 to 255) and&amp;#10;#   puts it out on 8 digital lines, which are recorded on the MEG&amp;#10;#   trigger channel. Red and green are ignored, so we keep them at 0.&amp;#10;#&amp;#10;#   Each of these blue values switches on exactly ONE of the 8 lines:&amp;#10;#       1, 2, 4, 8, 16, 32, 64, 128&amp;#10;#   Blue = 0 (a black pixel) means all lines are off.&amp;#10;#&amp;#10;#   So to &quot;send trigger 2&quot; we colour that one pixel (0, 0, 2) for one&amp;#10;#   frame, then make it black again. The pixel is too dark to see.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- The trigger colours used in this experiment --------------------&amp;#10;TRIG_STANDARD    = (0, 0,  1)   # standard tone onset        -&gt; MEG trigger 1&amp;#10;TRIG_DEVIANT     = (0, 0,  2)   # deviant tone onset         -&gt; MEG trigger 2&amp;#10;TRIG_BLINK       = (0, 0,  4)   # BLINK cue onset            -&gt; MEG trigger 4&amp;#10;TRIG_CUE_LEFT    = (0, 0,  8)   # left-hand cue arrows       -&gt; MEG trigger 8&amp;#10;TRIG_CUE_RIGHT   = (0, 0, 16)   # right-hand cue arrows      -&gt; MEG trigger 16&amp;#10;TRIG_FEEDBACK    = (0, 0, 32)   # MISS or WRONG BUTTON       -&gt; MEG trigger 32&amp;#10;TRIG_OFF         = (0, 0,  0)   # black pixel                -&gt; all lines off&amp;#10;&amp;#10;# Unused values on the 8-line channel: 64 and 128. Reserved for future&amp;#10;# event markers if the paradigm grows.&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# triggerSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the window opens, straight after vpixxSetup.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. creates the 1x1 trigger pixel in the top-left corner&amp;#10;#   2. defines the functions that colour it, send triggers and read the&amp;#10;#      DATAPixx3's clock&amp;#10;#&amp;#10;# Pixel Mode itself is switched on later, by the triggersOn routine&amp;#10;# after the drift check, and off on the thanks screen.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. The trigger pixel --------------------------------------------&amp;#10;screenWidthPix, screenHeightPix = win.size&amp;#10;triggerPixel = visual.Rect(&amp;#10;    win,&amp;#10;    units='pix',&amp;#10;    width=1,&amp;#10;    height=1,&amp;#10;    pos=(-screenWidthPix / 2 + 0.5, screenHeightPix / 2 - 0.5),&amp;#10;    colorSpace='rgb255',&amp;#10;    fillColor=TRIG_OFF,&amp;#10;    lineColor=TRIG_OFF,&amp;#10;    lineWidth=0,&amp;#10;    interpolate=False,&amp;#10;    autoLog=False,&amp;#10;)&amp;#10;triggerPixel.setAutoDraw(True)&amp;#10;&amp;#10;&amp;#10;# ---- 2. Functions used by the other components -----------------------&amp;#10;def setTriggerPixel(colour):&amp;#10;    &quot;&quot;&quot;Give the trigger pixel a new colour. Change appears at next refresh.&quot;&quot;&quot;&amp;#10;    triggerPixel.fillColor = colour&amp;#10;    triggerPixel.lineColor = colour&amp;#10;&amp;#10;&amp;#10;# Per-trial VPIXX-clock timestamps, looked up by name, e.g.&amp;#10;# vpixxTimes['deviant']. trialLog copies them into the trial log.&amp;#10;vpixxTimes = {}&amp;#10;&amp;#10;&amp;#10;def recordVpixxTime(stimName):&amp;#10;    &quot;&quot;&quot;Save the DATAPixx3's own clock as the column stimName + '_vp'.&amp;#10;    sendTrigger() queues this to run straight after the refresh that&amp;#10;    showed the trigger, so the time marks that refresh.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        vpixxTimes[stimName] = None&amp;#10;        return&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    vpixxTimes[stimName] = dp.DPxGetTime()&amp;#10;&amp;#10;&amp;#10;def sendTrigger(colour, stimName):&amp;#10;    &quot;&quot;&quot;Show a trigger colour on the next screen refresh and log it.&amp;#10;    colour   : one of the TRIG_ values, e.g. TRIG_DEVIANT&amp;#10;    stimName : short name, e.g. 'deviant'; the trial log stores its&amp;#10;               VPIXX-clock timestamp as stimName + '_vp'.&quot;&quot;&quot;&amp;#10;    setTriggerPixel(colour)&amp;#10;    # win.callOnFlip(function, argument) runs the function straight&amp;#10;    # after the next screen refresh, the one that shows this trigger.&amp;#10;    win.callOnFlip(recordVpixxTime, stimName)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="triggerSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="toneSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# toneSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the&amp;#10;#               window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the tone parameters and makes both tones (standard&amp;#10;#               and deviant).&amp;#10;#&amp;#10;# HOW THE SOUND IS PLAYED (read this first):&amp;#10;#   The tones are played by the DATAPixx3, not the stimulus PC's sound&amp;#10;#   card. The DATAPixx3 has its own memory and its own audio output.&amp;#10;#     1. At the start of the experiment we copy BOTH tones, once, into&amp;#10;#        the DATAPixx3's memory (Begin Experiment tab).&amp;#10;#     2. Each tone's trial-time play is set up in tone's trialSetup:&amp;#10;#        we give the DATAPixx3 an audio schedule saying &quot;play buffer at&amp;#10;#        standardAddress&quot; or &quot;play buffer at deviantAddress&quot;, mono.&amp;#10;#     3. On the frame the tone should start, we tell it &quot;start&quot;, timed&amp;#10;#        to arrive exactly when the screen refreshes.&amp;#10;# ======================================================================&amp;#10;&amp;#10;import numpy as np&amp;#10;&amp;#10;# ---- Tone parameters -------------------------------------------------&amp;#10;standardFreqHz   = 1000         # standard tone pitch (Hz)&amp;#10;deviantFreqHz    = 1200         # deviant tone pitch (Hz)&amp;#10;toneDurationSec  = 0.400        # both tones 400 ms&amp;#10;rampSec          = 0.010        # 10 ms fade-in/out (avoids clicks)&amp;#10;sampleRate       = 48000        # DATAPixx3 audio sample rate&amp;#10;toneLoudness     = 0.8          # 0 to 1&amp;#10;audioVolume      = 0.5          # DATAPixx3 output volume, both ears&amp;#10;&amp;#10;# Buffer addresses in the DATAPixx3's audio RAM. 16,000,000 is the&amp;#10;# address VPixx uses by default; put the deviant 0.5 MB later.&amp;#10;standardAddress  = 16_000_000&amp;#10;deviantAddress   = 16_500_000&amp;#10;&amp;#10;&amp;#10;def _make_tone(freqHz, duration_s, ramp_s, sample_rate, loudness):&amp;#10;    &quot;&quot;&quot;Build an int16 pure tone with cosine fade-in/out.&quot;&quot;&quot;&amp;#10;    nSamples = int(round(duration_s * sample_rate))&amp;#10;    t = np.arange(nSamples) / sample_rate&amp;#10;    wave = np.sin(2 * np.pi * freqHz * t)&amp;#10;    nRamp = int(round(ramp_s * sample_rate))&amp;#10;    fade = 0.5 * (1 - np.cos(np.pi * np.arange(nRamp) / nRamp))&amp;#10;    wave[:nRamp] = wave[:nRamp] * fade&amp;#10;    wave[-nRamp:] = wave[-nRamp:] * fade[::-1]&amp;#10;    return (wave * loudness * 32767).astype(np.int16)&amp;#10;&amp;#10;&amp;#10;standardWave = _make_tone(standardFreqHz, toneDurationSec,&amp;#10;                          rampSec, sampleRate, toneLoudness)&amp;#10;deviantWave  = _make_tone(deviantFreqHz,  toneDurationSec,&amp;#10;                          rampSec, sampleRate, toneLoudness)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# toneSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the window opens, straight after vpixxSetup&amp;#10;#               and triggerSetup.&amp;#10;#&amp;#10;# WHAT IT DOES: turns the DATAPixx3's audio on and copies BOTH tones&amp;#10;#               into its memory. In dummy mode (no DATAPixx3) it&amp;#10;#               prepares ordinary PsychoPy sounds instead.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    # ---- Real DATAPixx3 ----------------------------------------------&amp;#10;    dp.DPxInitAudCodec()&amp;#10;    # Device opens at volume 0 (silent) every time, so set it here.&amp;#10;    dp.DPxSetAudLeftVolume(audioVolume)&amp;#10;    dp.DPxSetAudRightVolume(audioVolume)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;    # Copy both tones into memory, each at its own address.&amp;#10;    dp.DPxWriteAudioBuffer(standardWave, standardAddress)&amp;#10;    dp.DPxWriteAudioBuffer(deviantWave,  deviantAddress)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;    logging.exp('DATAPixx3 audio ready: standard %d samples, deviant %d samples'&amp;#10;                % (len(standardWave), len(deviantWave)))&amp;#10;&amp;#10;else:&amp;#10;    # ---- Dummy mode: use PsychoPy sound instead ----------------------&amp;#10;    # Timing is approximate (OS audio latency); use dummy mode for&amp;#10;    # testing only. Mono sounds, played through the default device.&amp;#10;    standardSound = sound.Sound(standardWave.astype(np.float32) / 32767.0,&amp;#10;                                sampleRate=sampleRate, stereo=False)&amp;#10;    deviantSound  = sound.Sound(deviantWave.astype(np.float32) / 32767.0,&amp;#10;                                sampleRate=sampleRate, stereo=False)&amp;#10;&amp;#10;&amp;#10;def prep_tone_schedule(kind):&amp;#10;    &quot;&quot;&quot;Set the DATAPixx3's audio schedule to play one tone (standard&amp;#10;    or deviant) in mono on the next 'start'. Call BEFORE arming&amp;#10;    DPxStartAudSched + DPxWriteRegCacheAfterVideoSync.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    if kind == 'deviant':&amp;#10;        addr, nSamp = deviantAddress, len(deviantWave)&amp;#10;    else:&amp;#10;        addr, nSamp = standardAddress, len(standardWave)&amp;#10;    # 'mono' sends the buffer to both ears.&amp;#10;    dp.DPxSetAudioSchedule(0.0, sampleRate, nSamp, 'mono', addr)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="toneSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="sequenceGen" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# sequenceGen  |  &quot;Begin Routine&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the instructions screen first appears.&amp;#10;#&amp;#10;# WHAT IT DOES: generates fresh trial sequences for the training block&amp;#10;#               and the three main blocks. Each sequence is a list of&amp;#10;#               trials with cue hand, standard count, and inter-stimulus&amp;#10;#               intervals pre-drawn. Writes them to CSV files in the&amp;#10;#               session's data folder; the Builder loops point at those&amp;#10;#               files for their conditions.&amp;#10;#&amp;#10;# WHY HERE (not Begin Experiment):&amp;#10;#   We need expInfo['participant'] and expInfo['session'] to name the&amp;#10;#   CSVs. Those are only populated after the start dialog closes, so&amp;#10;#   this must be a Begin Routine of the first user-facing routine.&amp;#10;# ======================================================================&amp;#10;&amp;#10;import csv&amp;#10;import json&amp;#10;import os&amp;#10;import random&amp;#10;&amp;#10;# ---- Design parameters (edit here) -----------------------------------&amp;#10;N_TRAINING_TRIALS   = 20&amp;#10;N_MAIN_TRIALS       = 100&amp;#10;N_BLOCKS            = 3&amp;#10;MIN_STANDARDS       = 3    # min standards before each deviant&amp;#10;MAX_STANDARDS       = 7    # max standards before each deviant&amp;#10;ISI_MIN             = 0.700&amp;#10;ISI_MAX             = 0.900&amp;#10;&amp;#10;# ---- Session results folder ------------------------------------------&amp;#10;# Builder sets thisExp.dataFileName to the base path for its own output&amp;#10;# files (no extension). We write our conditions CSVs next to those.&amp;#10;_results_dir = os.path.dirname(thisExp.dataFileName)&amp;#10;if _results_dir and not os.path.isdir(_results_dir):&amp;#10;    os.makedirs(_results_dir, exist_ok=True)&amp;#10;_base_name = os.path.basename(thisExp.dataFileName)&amp;#10;&amp;#10;&amp;#10;def _generate_block(n_trials, is_training_flag, seed=None):&amp;#10;    &quot;&quot;&quot;Make one block's trial list.&amp;#10;&amp;#10;    cue_hand is balanced 50/50 and shuffled.&amp;#10;    n_standards is drawn uniformly from [MIN_STANDARDS, MAX_STANDARDS].&amp;#10;    ISIs are drawn uniformly from [ISI_MIN, ISI_MAX], one per standard&amp;#10;    tone (the deviant has none after it).&amp;#10;&amp;#10;    is_training_flag is written as a column so trial code can tell&amp;#10;    which outer loop it is in (there are two tone_loops with&amp;#10;    different names, one per outer loop; see tonePresent).&amp;#10;    &quot;&quot;&quot;&amp;#10;    rng = random.Random(seed)&amp;#10;    half = n_trials // 2&amp;#10;    hands = ['left'] * half + ['right'] * (n_trials - half)&amp;#10;    rng.shuffle(hands)&amp;#10;    trials = []&amp;#10;    for hand in hands:&amp;#10;        n_std = rng.randint(MIN_STANDARDS, MAX_STANDARDS)&amp;#10;        # One ISI per standard (deviant tone comes last, no ISI after)&amp;#10;        isis = [round(rng.uniform(ISI_MIN, ISI_MAX), 4) for _ in range(n_std)]&amp;#10;        trials.append({&amp;#10;            'cue_hand':        hand,&amp;#10;            'expected_button': '1' if hand == 'left' else '2',&amp;#10;            'n_standards':     n_std,&amp;#10;            'isis_json':       json.dumps(isis),&amp;#10;            'is_training':     is_training_flag,&amp;#10;        })&amp;#10;    return trials&amp;#10;&amp;#10;&amp;#10;def _write_conditions_csv(path, trials):&amp;#10;    &quot;&quot;&quot;Write a Builder-compatible conditions CSV.&quot;&quot;&quot;&amp;#10;    fieldnames = ['cue_hand', 'expected_button', 'n_standards',&amp;#10;                  'isis_json', 'is_training']&amp;#10;    with open(path, 'w', newline='') as f:&amp;#10;        w = csv.DictWriter(f, fieldnames=fieldnames)&amp;#10;        w.writeheader()&amp;#10;        w.writerows(trials)&amp;#10;&amp;#10;&amp;#10;# Fresh random seed each session (different subjects get different&amp;#10;# sequences). The seed is recorded in the data file so a run can be&amp;#10;# reproduced if needed.&amp;#10;_session_seed = random.randrange(2**31)&amp;#10;thisExp.addData('session_seed', _session_seed)&amp;#10;_seed_rng = random.Random(_session_seed)&amp;#10;&amp;#10;# ---- Training block --------------------------------------------------&amp;#10;training_csv = os.path.join(_results_dir, _base_name + '_training.csv')&amp;#10;_write_conditions_csv(training_csv,&amp;#10;                      _generate_block(N_TRAINING_TRIALS,&amp;#10;                                      is_training_flag=True,&amp;#10;                                      seed=_seed_rng.randrange(2**31)))&amp;#10;&amp;#10;# ---- Main blocks: one CSV per block ----------------------------------&amp;#10;# A list of per-block CSV paths, used by the block loop below.&amp;#10;block_csvs = []&amp;#10;for b in range(1, N_BLOCKS + 1):&amp;#10;    path = os.path.join(_results_dir,&amp;#10;                        _base_name + f'_block{b}.csv')&amp;#10;    _write_conditions_csv(path, _generate_block(&amp;#10;        N_MAIN_TRIALS, is_training_flag=False,&amp;#10;        seed=_seed_rng.randrange(2**31)))&amp;#10;    block_csvs.append(path)&amp;#10;&amp;#10;logging.exp(f'Generated conditions: training={training_csv}')&amp;#10;for i, p in enumerate(block_csvs, 1):&amp;#10;    logging.exp(f'Generated conditions: block {i}={p}')&amp;#10;&amp;#10;# ---- Running counts for progress and summary -------------------------&amp;#10;overall_trial     = 0        # bumped at the start of every trial&amp;#10;training_results  = []       # list of outcome strings&amp;#10;main_results      = []       # list of (block, outcome) tuples&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="sequenceGen" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="responseClassifySetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;Begin Experiment&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: creates one Keyboard() object shared across trials.&amp;#10;#               Keyboard() uses PsychoPy's modern low-latency backend&amp;#10;#               when available (ptb). We poll it manually in Each Frame&amp;#10;#               rather than using a KeyboardComponent, because the HID&amp;#10;#               pipeline on Windows needs the message queue pumped by&amp;#10;#               win.flip() to notice presses -- a core.wait during the&amp;#10;#               response window drops events.&amp;#10;#&amp;#10;# KEY_CODES: edit here if the button box emits different key names.&amp;#10;# ======================================================================&amp;#10;&amp;#10;from psychopy.hardware import keyboard&amp;#10;&amp;#10;kb = keyboard.Keyboard()&amp;#10;kb.clearEvents()&amp;#10;&amp;#10;KEY_CODES = {&amp;#10;    '1': 'left_index',&amp;#10;    '2': 'right_index',&amp;#10;}&amp;#10;EXIT_KEY = 'escape'&amp;#10;&amp;#10;# Per-trial event buffer (reset in Begin Routine)&amp;#10;trial_events = []&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="responseClassifySetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="cueSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;Begin Experiment&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: makes the four cue-arrow TextStims (left-pair and&amp;#10;#               right-pair, two arrows each). Reused on every trial.&amp;#10;# ======================================================================&amp;#10;&amp;#10;cue_left_arrows = [&amp;#10;    visual.TextStim(win, text='&lt;', color='white', height=60,&amp;#10;                    pos=(-CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;    visual.TextStim(win, text='&lt;', color='white', height=60,&amp;#10;                    pos=(+CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;]&amp;#10;cue_right_arrows = [&amp;#10;    visual.TextStim(win, text='&gt;', color='white', height=60,&amp;#10;                    pos=(-CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;    visual.TextStim(win, text='&gt;', color='white', height=60,&amp;#10;                    pos=(+CUE_ARROW_OFFSET_PX, 0), autoLog=False),&amp;#10;]&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="cueSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="feedbackSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# feedbackSelect  |  &quot;Begin Experiment&quot; tab  |  routine: feedback&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Creates the two feedback TextStims. Both red, big, bold.&amp;#10;# ======================================================================&amp;#10;&amp;#10;feedback_miss_stim = visual.TextStim(&amp;#10;    win, text='MISS', color='red', height=80, bold=True, autoLog=False,&amp;#10;)&amp;#10;feedback_wrong_stim = visual.TextStim(&amp;#10;    win, text='WRONG BUTTON', color='red', height=60, bold=True,&amp;#10;    autoLog=False,&amp;#10;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
