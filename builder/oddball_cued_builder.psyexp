        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Eye tracker setup&amp;#10;&amp;#10;Please keep your head still and look at the screen.&amp;#10;&amp;#10;We will now calibrate the eye tracker: follow the dot with your eyes and look at its centre until it moves.&amp;#10;&amp;#10;(Experimenter: press SPACE to enter Camera Setup.&amp;#10;Enter = camera image, C = calibrate, V = validate, O = continue to the task.)" valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1500" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="key_setup" plugin="None">
        <Param val="&quot;space&quot;" valType="list" updates="constant" name="allowedKeys"/>
