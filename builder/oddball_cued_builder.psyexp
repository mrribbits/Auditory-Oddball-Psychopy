        <Param val="# ======================================================================&amp;#10;# elConfig  |  &quot;Begin Routine&quot; tab  |  routine: eyelinkSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Sets EyeLink sample rate to 500 Hz and writes SESSION_CONFIG into EDF.&amp;#10;# ======================================================================&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;&amp;#10;if not dummy_mode:&amp;#10;    el_tracker.setOfflineMode()&amp;#10;    el_tracker.sendCommand(&quot;sample_rate 500&quot;)&amp;#10;    el_tracker.sendMessage(&quot;SESSION_CONFIG remote_mode sample_rate_500&quot;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
