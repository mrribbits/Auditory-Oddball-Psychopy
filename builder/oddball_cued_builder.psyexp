    <Routine name="blink">
      <RoutineSettingsComponent name="blink" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="blink" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="blinkPresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# blinkPresent  |  &quot;Begin Routine&quot; tab  |  routine: blink&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of each trial's BLINK phase.&amp;#10;#&amp;#10;# WHAT IT DOES: sends the BLINK trigger. Text is drawn each frame.&amp;#10;# ======================================================================&amp;#10;sendTrigger(TRIG_BLINK, 'blink')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="blink_text_stim.draw()&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# Save the BLINK onset for the trial log.&amp;#10;blink_onset_pp = blink.tStartRefresh&amp;#10;blink_onset_vp = vpixxTimes.get('blink')&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="blinkPresent" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>

    <Routine name="trialLog">
      <RoutineSettingsComponent name="trialLog" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="trialLog" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="trialLogWrite" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;End Routine&quot; tab  |  routine: trialLog&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial, after all other routines.&amp;#10;#&amp;#10;# WHAT IT DOES: writes one trial row, N tone rows, M press rows, and&amp;#10;#               flushes to disk so a crash doesn't lose completed trials.&amp;#10;# ======================================================================&amp;#10;&amp;#10;&amp;#10;def _fmt_pp(val, p=6):&amp;#10;    return '' if val is None else ('%.*f' % (p, val))&amp;#10;&amp;#10;&amp;#10;def _fmt_vp(val, p=6):&amp;#10;    # Blank in dummy mode (vpixxTimes stores None then anyway)&amp;#10;    if DUMMY_VPIXX or val is None:&amp;#10;        return ''&amp;#10;    return '%.*f' % (p, val)&amp;#10;&amp;#10;&amp;#10;_fixation_pp = fixation.tStartRefresh if hasattr(fixation, 'tStartRefresh') else None&amp;#10;_fixation_vp = vpixxTimes.get('fixation')&amp;#10;&amp;#10;trials_log_writer.writerow({&amp;#10;    'overall_trial':        overall_trial,&amp;#10;    'block':                block_label,&amp;#10;    'trial_in_block':       trial_in_block,&amp;#10;    'is_training':          is_training,&amp;#10;    'cue_hand':             cue_hand,&amp;#10;    'expected_button':      expected_button,&amp;#10;    'n_standards':          n_standards,&amp;#10;    'fixation_onset_pp':    _fmt_pp(_fixation_pp),&amp;#10;    'fixation_onset_vp':    _fmt_vp(_fixation_vp),&amp;#10;    'cue_onset_pp':         _fmt_pp(cue_onset_pp),&amp;#10;    'cue_onset_vp':         _fmt_vp(vpixxTimes.get('cue')),&amp;#10;    'first_tone_onset_pp':  _fmt_pp(first_tone_onset_pp),&amp;#10;    'first_tone_onset_vp':  _fmt_vp(first_tone_onset_vp),&amp;#10;    'deviant_onset_pp':     _fmt_pp(deviant_onset_pp),&amp;#10;    'deviant_onset_vp':     _fmt_vp(deviant_onset_vp),&amp;#10;    'response_button':      response_button,&amp;#10;    'response_key_name':    response_key_name,&amp;#10;    'response_time_pp':     _fmt_pp(response_time_pp),&amp;#10;    'response_time_vp_est': _fmt_vp(response_time_vp_est),&amp;#10;    'rt_pp':                '' if (rt_pp != rt_pp) else '%.4f' % rt_pp,&amp;#10;    'rt_vp_est':            '' if (DUMMY_VPIXX or rt_vp_est != rt_vp_est) else '%.4f' % rt_vp_est,&amp;#10;    'outcome':              outcome,&amp;#10;    'feedback_shown':       feedback_shown,&amp;#10;    'blink_onset_pp':       _fmt_pp(blink_onset_pp),&amp;#10;    'blink_onset_vp':       _fmt_vp(blink_onset_vp),&amp;#10;    'dummy_vpixx':          DUMMY_VPIXX,&amp;#10;})&amp;#10;&amp;#10;for row in tones_log_rows:&amp;#10;    tones_log_writer.writerow(row)&amp;#10;tones_log_rows.clear()&amp;#10;&amp;#10;for row in presses_log_rows:&amp;#10;    presses_log_writer.writerow(row)&amp;#10;presses_log_rows.clear()&amp;#10;&amp;#10;# Keep running tallies for the end-of-experiment summary&amp;#10;if is_training:&amp;#10;    training_results.append(outcome)&amp;#10;else:&amp;#10;    main_results.append((block_label, outcome))&amp;#10;&amp;#10;# Flush to disk after every trial (crash-safe)&amp;#10;for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;    _fh.flush()&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialLogWrite" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>

    <Routine name="trainingTransition">
      <RoutineSettingsComponent name="trainingTransition" plugin="None">
