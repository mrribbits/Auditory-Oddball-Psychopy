    <Routine name="triggersOn">
      <RoutineSettingsComponent name="triggersOn" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="Switches VPixx Pixel Mode B on after the drift check" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="triggersOn" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="pixelModeOn" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# pixelModeOn  |  &quot;Begin Routine&quot; tab  |  routine: triggersOn&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, right after the initial drift check and before&amp;#10;#               the first training trial.&amp;#10;#&amp;#10;# WHAT IT DOES: switches the DATAPixx3 into Pixel Mode B. From here&amp;#10;#               on, the top-left pixel's BLUE value is read on every&amp;#10;#               screen refresh and output on the 8 MEG trigger lines&amp;#10;#               (1, 2, 4, 8, 16, 32, 64, 128).&amp;#10;#&amp;#10;# WHY NOT ENABLE PIXEL MODE FROM THE START:&amp;#10;#   The EyeLink calibration and drift-check screens draw their own&amp;#10;#   content (including whatever colour happens to be in the top-left&amp;#10;#   pixel) and we don't want their random pixel colours reaching the&amp;#10;#   MEG as junk triggers. vpixxSetup opens the device with Pixel Mode&amp;#10;#   OFF; this routine turns it on only after calibration is done.&amp;#10;#   pixelModeOff (in the thanks routine) turns it back off before the&amp;#10;#   EyeLink plugin's file-copy screens show.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   dp, DUMMY_VPIXX           - vpixxSetup (instruct routine)&amp;#10;#   setTriggerPixel, TRIG_OFF - triggerSetup (instruct routine)&amp;#10;#   logging                   - PsychoPy (available everywhere)&amp;#10;# ======================================================================&amp;#10;setTriggerPixel(TRIG_OFF)            # start with the pixel black&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxEnableDoutPixelModeB()&amp;#10;    dp.DPxWriteRegCache()            # push the enable to the device&amp;#10;    logging.exp('VPixx Pixel Mode B ON')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="pixelModeOn" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="trialSetup">
      <RoutineSettingsComponent name="trialSetup" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trialSetup" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="trialSetupCode" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# trialSetupCode  |  &quot;Begin Routine&quot; tab  |  routine: trialSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial, as the first thing in the&amp;#10;#               trialSetup routine. Builder has already loaded this&amp;#10;#               trial's row from the conditions CSV and set each column&amp;#10;#               as a local variable (cue_hand, expected_button,&amp;#10;#               n_standards, isis_json, is_training).&amp;#10;#&amp;#10;# WHAT IT DOES: five preparation steps per trial.&amp;#10;#&amp;#10;#   1. Parse the per-tone ISI list from JSON (or accept a list if&amp;#10;#      Builder already parsed it).&amp;#10;#   2. Set tone_loop_reps so the inner tone_loop iterates once per&amp;#10;#      standard tone PLUS once for the deviant at the end.&amp;#10;#   3. Convert is_training (which may arrive as 'True'/'False' string)&amp;#10;#      into a real Python bool for later tests.&amp;#10;#   4. Clear the per-trial VPIXX-timestamp dict and reset all&amp;#10;#      trial-level variables that trialLog will later write.&amp;#10;#   5. Bump the running overall_trial counter.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   cue_hand, expected_button,&amp;#10;#   n_standards, isis_json,&amp;#10;#   is_training          - this trial's row of the conditions CSV&amp;#10;#                           (loaded by Builder before this routine)&amp;#10;#   vpixxTimes           - triggerSetup Begin Experiment (shared dict)&amp;#10;#   overall_trial        - sequenceGen Begin Routine (initialised 0)&amp;#10;#   json                 - sequenceGen Before Experiment (module import)&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. Parse the per-tone ISI list ---------------------------------&amp;#10;# isis_json is the per-trial ISI list, one gap after each standard&amp;#10;# (the deviant has no gap after it, it's the last tone). The CSV&amp;#10;# writes it as a JSON string (&quot;[0.75, 0.82, ...]&quot;), but Builder's&amp;#10;# conditions loader may auto-parse that cell into a Python list.&amp;#10;# Handle both forms.&amp;#10;if isinstance(isis_json, str):&amp;#10;    isi_list = json.loads(isis_json)&amp;#10;else:&amp;#10;    isi_list = list(isis_json)&amp;#10;&amp;#10;# ---- 2. Set tone_loop iteration count -------------------------------&amp;#10;# tone_loop reads this each time it starts (before its first iteration)&amp;#10;# because its nReps field is $tone_loop_reps. n_standards is the number&amp;#10;# of standards BEFORE the deviant; +1 adds the deviant itself.&amp;#10;tone_loop_reps = int(n_standards) + 1&amp;#10;&amp;#10;# ---- 3. Training vs main --------------------------------------------&amp;#10;# `is_training` comes in as a column of the conditions CSV: True in&amp;#10;# the training CSV, False in the three block CSVs. Builder loads it&amp;#10;# as a local variable for each trial, but we must NOT reassign the&amp;#10;# bare name `is_training` here -- Python's compiler would then mark&amp;#10;# `is_training` as a local of Builder's run() function, and the&amp;#10;# right-hand-side read on the self-assign line would raise&amp;#10;# UnboundLocalError (the Builder injection happens via a different&amp;#10;# mechanism than the compiler can see).&amp;#10;#&amp;#10;# Instead compute a differently-named bool. All later references in&amp;#10;# the trial routines (tonePresent, trialLogWrite, blockControl) use&amp;#10;# this new name.&amp;#10;is_training_bool = str(is_training).lower() == 'true'&amp;#10;&amp;#10;# ---- 4. Fresh per-trial state ---------------------------------------&amp;#10;vpixxTimes.clear()&amp;#10;tone_index_in_trial = 0          # 0-indexed, bumped before each tone&amp;#10;first_tone_onset_pp = None&amp;#10;first_tone_onset_vp = None&amp;#10;deviant_onset_pp    = None&amp;#10;deviant_onset_vp    = None&amp;#10;&amp;#10;# Response fields default to 'no press'&amp;#10;response_button    = ''&amp;#10;response_key_name  = ''&amp;#10;response_time_pp   = None&amp;#10;response_time_vp_est = None&amp;#10;rt_pp              = float('nan')&amp;#10;rt_vp_est          = float('nan')&amp;#10;outcome            = 'miss'&amp;#10;feedback_shown     = False&amp;#10;&amp;#10;# Running trial counter (incremented in sequenceGen; here we bump it)&amp;#10;overall_trial += 1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialSetupCode" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="blockControl" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# blockControl  |  &quot;Begin Routine&quot; tab  |  routine: trialSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial (training or main),&amp;#10;#               AFTER trialSetupCode (which sets is_training_bool).&amp;#10;#&amp;#10;# WHAT IT DOES: computes two label fields written to the trial log:&amp;#10;#               - block_label: 'training' or 'block_1' / 'block_2' /&amp;#10;#                 'block_3'. Lets you filter the data file later.&amp;#10;#               - trial_in_block: 1-based trial number within this&amp;#10;#                 block (resets at the start of each block).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   is_training_bool                  - trialSetupCode (this routine)&amp;#10;#   training_trials.thisN             - Builder: 0-based index of the&amp;#10;#                                        current training loop iteration&amp;#10;#   block_loop.thisN, block_trials.thisN&amp;#10;#                                     - Builder: 0-based indices of the&amp;#10;#                                        main block loop and its trials&amp;#10;# ======================================================================&amp;#10;if is_training_bool:&amp;#10;    block_label    = 'training'&amp;#10;    trial_in_block = training_trials.thisN + 1&amp;#10;else:&amp;#10;    block_label    = 'block_%d' % (block_loop.thisN + 1)&amp;#10;    trial_in_block = block_trials.thisN + 1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="blockControl" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="fixation">
      <RoutineSettingsComponent name="fixation" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="fixation" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="fixationTriggerClear" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Clear any lingering trigger pixel.&amp;#10;setTriggerPixel(TRIG_OFF)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="fixationTriggerClear" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="2" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="fixation_cross" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(32, 32)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="FIXATION_DURATION" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
    </Routine>
    <Routine name="cue">
      <RoutineSettingsComponent name="cue" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="cue" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="cuePresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;Begin Routine&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of every trial's cue phase (500 ms).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. picks which arrow pair (left or right) to draw this trial&amp;#10;#   2. sends the appropriate MEG trigger (8 for left, 16 for right) on&amp;#10;#      the next screen refresh via sendTrigger()&amp;#10;#&amp;#10;# The fixation cross stays on throughout the cue phase; it is drawn by&amp;#10;# the cue_fixation_cross PolygonComponent in this routine, not here.&amp;#10;# The arrows are drawn by this component's Each Frame code (below).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   cue_hand               - this trial's row of the conditions CSV&amp;#10;#                            ('left' or 'right')&amp;#10;#   cue_left_arrows,&amp;#10;#   cue_right_arrows       - cueSetup Before Experiment (instruct routine)&amp;#10;#   TRIG_CUE_LEFT,&amp;#10;#   TRIG_CUE_RIGHT         - triggerSetup Before Experiment (instruct)&amp;#10;#   sendTrigger            - triggerSetup Begin Experiment (instruct)&amp;#10;# ======================================================================&amp;#10;&amp;#10;if cue_hand == 'left':&amp;#10;    cue_arrows_to_draw = cue_left_arrows&amp;#10;    sendTrigger(TRIG_CUE_LEFT, 'cue')&amp;#10;else:&amp;#10;    cue_arrows_to_draw = cue_right_arrows&amp;#10;    sendTrigger(TRIG_CUE_RIGHT, 'cue')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;Each Frame&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every screen refresh during the cue phase (~60 frames&amp;#10;#               at 120 Hz over 500 ms).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. draws the two cue arrows on top of the fixation cross&amp;#10;#   2. after the first frame, blanks the trigger pixel so the cue&amp;#10;#      trigger pulse is exactly ONE frame long (~8.3 ms at 120 Hz)&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   cue_arrows_to_draw   - Begin Routine tab, this component&amp;#10;#   frameN               - Builder: current frame index in this routine&amp;#10;#                           (0 on first frame, 1 on second, ...)&amp;#10;#   setTriggerPixel,&amp;#10;#   TRIG_OFF             - triggerSetup (instruct routine)&amp;#10;# ======================================================================&amp;#10;&amp;#10;# Draw both arrows this frame. The fixation PolygonComponent in this&amp;#10;# routine draws the cross; both are composed into one flip.&amp;#10;for a in cue_arrows_to_draw:&amp;#10;    a.draw()&amp;#10;&amp;#10;# Trigger pulse is 1 frame. On frame 0 the pixel is coloured (by&amp;#10;# sendTrigger in Begin Routine); from frame 1 onward it goes black.&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;End Routine&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the end of the cue phase (500 ms after it began).&amp;#10;#&amp;#10;# WHAT IT DOES: records the PsychoPy-clock time when the cue first&amp;#10;#               appeared on screen. trialLog writes this to the trial&amp;#10;#               CSV as `cue_onset_pp`.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   cue.tStartRefresh - Builder: the screen-refresh time at which this&amp;#10;#                       routine's first frame was displayed. Builder&amp;#10;#                       sets this automatically for every routine.&amp;#10;# ======================================================================&amp;#10;cue_onset_pp = cue.tStartRefresh&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="cuePresent" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="cue_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="2" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="cue_fixation_cross" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(32, 32)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="CUE_DURATION" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
    </Routine>
    <Routine name="tone">
      <RoutineSettingsComponent name="tone" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="tone" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="tonePresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;Begin Routine&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of each tone (standard or deviant),&amp;#10;#               inside tone_loop. The tone_loop iterates&amp;#10;#               n_standards + 1 times per trial (one per standard tone&amp;#10;#               plus one for the deviant at the end).&amp;#10;#&amp;#10;# WHAT IT DOES: three preparation steps BEFORE the first screen flip:&amp;#10;#   1. Figures out which tone this is (standard vs deviant)&amp;#10;#   2. Loads the right audio schedule onto the DATAPixx3 (not started&amp;#10;#      yet -- the actual &quot;start&quot; command goes out in Each Frame, timed&amp;#10;#      to the vsync so audio and trigger line up exactly)&amp;#10;#   3. Primes the trigger pixel colour for this tone (1 for standard,&amp;#10;#      2 for deviant) so that colour is driven out on DOUT at the next&amp;#10;#      vsync; also records the DATAPixx3 clock time at that same vsync&amp;#10;#      via win.callOnFlip&amp;#10;#&amp;#10;# TRIAL-STRUCTURE REMINDER:&amp;#10;#   This routine runs ONCE per tone (per iteration of tone_loop). The&amp;#10;#   full trial plays n_standards + 1 tones, each one playing through&amp;#10;#   this routine. The LAST iteration is the deviant.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   is_training_bool                      - trialSetupCode (trialSetup)&amp;#10;#   tone_loop_training / tone_loop_main   - Builder: there are two tone&amp;#10;#     loops in the Flow (one inside the training loop, one inside the&amp;#10;#     main block loop) with different names, so we pick whichever is&amp;#10;#     actually iterating this trial by checking is_training_bool.&amp;#10;#     Within either, .thisN is the 0-based iteration index.&amp;#10;#   tone_loop_reps                        - trialSetupCode (n_standards + 1)&amp;#10;#   prep_tone_schedule, standardSound,&amp;#10;#   deviantSound                          - toneSetup (instruct routine)&amp;#10;#   dp, DUMMY_VPIXX                       - vpixxSetup (instruct routine)&amp;#10;#   sendTrigger, TRIG_STANDARD,&amp;#10;#   TRIG_DEVIANT                          - triggerSetup (instruct routine)&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. Which tone is this? -----------------------------------------&amp;#10;_active_tone_loop = tone_loop_training if is_training_bool else tone_loop_main&amp;#10;tone_index_in_trial = _active_tone_loop.thisN   # 0, 1, 2, ..., n_standards&amp;#10;is_deviant = (tone_index_in_trial == tone_loop_reps - 1)&amp;#10;kind = 'deviant' if is_deviant else 'standard'&amp;#10;&amp;#10;# ---- 2. Load the audio schedule onto the DATAPixx3 ------------------&amp;#10;# prep_tone_schedule() tells the DATAPixx3 &quot;when I say start, play&amp;#10;# this tone from this memory address, in mono, at this sample rate.&quot;&amp;#10;# The config is pushed to the device but the start bit is NOT yet set&amp;#10;# -- that happens in Each Frame, right before the first flip, so the&amp;#10;# tone starts on the SAME vsync as the trigger pixel goes high.&amp;#10;prep_tone_schedule(kind)&amp;#10;&amp;#10;# ---- 3. Set the trigger pixel and queue a clock sample --------------&amp;#10;# sendTrigger() changes the trigger pixel colour. On the next screen&amp;#10;# refresh VPIXX reads that pixel and outputs the trigger number on the&amp;#10;# MEG trigger lines. It also uses win.callOnFlip() to record the&amp;#10;# DATAPixx3 clock time at that same refresh, stored in&amp;#10;# vpixxTimes['tone_&lt;n&gt;'] -- End Routine copies it to the tones log.&amp;#10;if is_deviant:&amp;#10;    sendTrigger(TRIG_DEVIANT, 'tone_%d' % (tone_index_in_trial + 1))&amp;#10;else:&amp;#10;    sendTrigger(TRIG_STANDARD, 'tone_%d' % (tone_index_in_trial + 1))&amp;#10;&amp;#10;# ---- Dummy-mode fallback audio --------------------------------------&amp;#10;# No DATAPixx3? Play the tone through PsychoPy's sound system instead.&amp;#10;# Timing is loose (OS audio latency) but good enough for development.&amp;#10;if DUMMY_VPIXX:&amp;#10;    _dummy_stim = deviantSound if is_deviant else standardSound&amp;#10;    _dummy_stim.stop()                      # in case still playing&amp;#10;    win.callOnFlip(_dummy_stim.play)        # play at next flip&amp;#10;&amp;#10;# Flag so Each Frame fires the DATAPixx3 &quot;start&quot; command exactly once&amp;#10;# (on frame 0 only, not every subsequent frame).&amp;#10;tone_audio_started = False&amp;#10;&amp;#10;# Filled in End Routine from tone.tStartRefresh.&amp;#10;tone_onset_pp_this = None&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;Each Frame&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every screen refresh during this tone's routine (~48&amp;#10;#               frames at 120 Hz for a 400 ms tone + ISI).&amp;#10;#&amp;#10;# WHAT IT DOES: two things, each on a specific frame.&amp;#10;#&amp;#10;#   On frame 0 (THIS routine's first frame, before the first flip):&amp;#10;#     Arms the DATAPixx3 to start audio playback at that flip. The two&amp;#10;#     calls below MUST be the last VPIXX commands before win.flip() --&amp;#10;#     anything that calls DPxUpdateRegCache() or DPxWriteRegCache()&amp;#10;#     between here and the flip would wipe the pending &quot;start&quot; bit.&amp;#10;#     That is why recordVpixxTime (which calls DPxUpdateRegCache) runs&amp;#10;#     AFTER the flip via win.callOnFlip, not before.&amp;#10;#&amp;#10;#   On frame 1 and later:&amp;#10;#     Blanks the trigger pixel so the MEG trigger pulse is exactly one&amp;#10;#     frame long (~8.3 ms at 120 Hz, which is ~10 samples at a 1200 Hz&amp;#10;#     MEG sample rate -- plenty for a stable edge).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   tone_audio_started, is_deviant   - Begin Routine (this component)&amp;#10;#   frameN                           - Builder: frame index in routine&amp;#10;#   dp, DUMMY_VPIXX                  - vpixxSetup (instruct routine)&amp;#10;#   setTriggerPixel, TRIG_OFF        - triggerSetup (instruct routine)&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not tone_audio_started and frameN == 0:&amp;#10;    if not DUMMY_VPIXX:&amp;#10;        # These two must be the LAST VPIXX calls before the next flip.&amp;#10;        dp.DPxStartAudSched()                 # arm audio start locally&amp;#10;        dp.DPxWriteRegCacheAfterVideoSync()   # push to device at next vsync&amp;#10;    tone_audio_started = True&amp;#10;&amp;#10;# One-frame trigger pulse: blank the pixel from frame 1 onward.&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;End Routine&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the end of each tone's routine (tone +&amp;#10;#               trailing ISI, except the deviant which has no ISI).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. Captures this tone's PsychoPy-clock onset (set by Builder as&amp;#10;#      tone.tStartRefresh) and VPIXX-clock onset (sampled by&amp;#10;#      recordVpixxTime at the flip, stored in vpixxTimes).&amp;#10;#   2. Saves the FIRST tone's and the DEVIANT tone's timestamps for&amp;#10;#      the trial log (fixed slots in the trial row).&amp;#10;#   3. Appends one row to the per-tone log file so every tone has its&amp;#10;#      own row with onset times (useful for MMN/P3 analyses).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   tone.tStartRefresh                  - Builder: when this routine's&amp;#10;#                                          first frame appeared on screen&amp;#10;#   vpixxTimes                          - triggerSetup Begin Experiment&amp;#10;#                                          (dict filled by recordVpixxTime)&amp;#10;#   tone_index_in_trial, is_deviant,&amp;#10;#   kind                                - Begin Routine (this component)&amp;#10;#   deviantFreqHz, standardFreqHz       - toneSetup Before Experiment&amp;#10;#   first_tone_onset_pp/vp,&amp;#10;#   deviant_onset_pp/vp                 - trialSetupCode (initialised None)&amp;#10;#   tones_log_rows                      - logFilesSetup Begin Experiment&amp;#10;#   overall_trial, block_label,&amp;#10;#   trial_in_block                      - trialSetupCode / blockControl&amp;#10;# ======================================================================&amp;#10;&amp;#10;tone_onset_pp_this = tone.tStartRefresh&amp;#10;tone_onset_vp_this = vpixxTimes.get('tone_%d' % (tone_index_in_trial + 1))&amp;#10;&amp;#10;# Remember the FIRST tone's onset times (for the trial log)&amp;#10;if tone_index_in_trial == 0:&amp;#10;    first_tone_onset_pp = tone_onset_pp_this&amp;#10;    first_tone_onset_vp = tone_onset_vp_this&amp;#10;&amp;#10;# Remember the DEVIANT tone's onset times (needed for response scoring&amp;#10;# in response_window, and for the trial log)&amp;#10;if is_deviant:&amp;#10;    deviant_onset_pp = tone_onset_pp_this&amp;#10;    deviant_onset_vp = tone_onset_vp_this&amp;#10;&amp;#10;# Append this tone's row to the per-tone log. Flushed to disk at the&amp;#10;# end of the trial by trialLog.&amp;#10;tones_log_rows.append({&amp;#10;    'overall_trial':  overall_trial,&amp;#10;    'block':          block_label,&amp;#10;    'trial_in_block': trial_in_block,&amp;#10;    'tone_index':     tone_index_in_trial + 1,   # 1-based for humans&amp;#10;    'kind':           kind,&amp;#10;    'frequency_hz':   deviantFreqHz if is_deviant else standardFreqHz,&amp;#10;    'onset_pp':       '%.6f' % tone_onset_pp_this,&amp;#10;    'onset_vp':       '' if tone_onset_vp_this is None else '%.6f' % tone_onset_vp_this,&amp;#10;})&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="tonePresent" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="tone_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="2" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="tone_fixation_cross" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(32, 32)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="TONE_DURATION + (isi_list[tone_index_in_trial] if tone_index_in_trial &lt; len(isi_list) else 0.0)" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
    </Routine>
    <Routine name="response_window">
      <RoutineSettingsComponent name="response_window" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="response_window" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="responseClassify" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;Begin Routine&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of the 1 s response window after the&amp;#10;#               deviant tone.&amp;#10;#&amp;#10;# WHAT IT DOES: resets the per-trial event buffer; drains any key&amp;#10;#               events pressed BEFORE this routine opened (e.g., a fast&amp;#10;#               correct press during the deviant tone itself); sets the&amp;#10;#               scoring-window boundaries relative to deviant onset.&amp;#10;#&amp;#10;# IMPORTANT (matches Coder script): we do NOT call kb.clearEvents()&amp;#10;# here. The valid scoring window starts 150 ms AFTER deviant onset,&amp;#10;# which is still DURING the deviant tone (tone duration = 400 ms).&amp;#10;# Presses made in that window must be preserved; wiping the buffer&amp;#10;# would drop them and score them as miss. The scoring logic in End&amp;#10;# Routine filters out presses outside the window, so any genuinely&amp;#10;# too-early presses (from the fixation / cue / earlier tones) are&amp;#10;# ignored there rather than here.&amp;#10;# ======================================================================&amp;#10;&amp;#10;trial_events = []&amp;#10;&amp;#10;# Drain any key events already in kb's buffer (pressed during the&amp;#10;# fixation, cue, or tone phases). These get added to trial_events with&amp;#10;# their actual key-down times; scoring filters by window.&amp;#10;_pre_window_events = kb.getKeys(keyList=list(KEY_CODES.keys()) + [EXIT_KEY],&amp;#10;                                 waitRelease=False)&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    _pre_vp = dp.DPxGetTime()&amp;#10;else:&amp;#10;    _pre_vp = 0.0&amp;#10;_pre_pp = core.getTime()&amp;#10;for key in _pre_window_events:&amp;#10;    if key.name == EXIT_KEY:&amp;#10;        continueRoutine = False&amp;#10;        break&amp;#10;    label = KEY_CODES.get(key.name)&amp;#10;    if label is None:&amp;#10;        continue&amp;#10;    trial_events.append({&amp;#10;        'kind':        'press',&amp;#10;        'label':       label,&amp;#10;        'key_name':    key.name,&amp;#10;        'time_pp':     key.tDown,&amp;#10;        'time_vp_est': _pre_vp + (key.tDown - _pre_pp),&amp;#10;    })&amp;#10;&amp;#10;# Scoring window boundaries (PsychoPy clock, from the deviant onset).&amp;#10;# Window spans 150 ms (anticipation floor) to deviant+1400 ms (deviant&amp;#10;# duration + response phase). Matches the Coder script's values.&amp;#10;if deviant_onset_pp is None:&amp;#10;    # Shouldn't happen but be safe&amp;#10;    resp_min_pp = float('inf')&amp;#10;    resp_max_pp = float('inf')&amp;#10;else:&amp;#10;    resp_min_pp = deviant_onset_pp + RESP_WIN_MIN&amp;#10;    resp_max_pp = deviant_onset_pp + RESP_WIN_MAX&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;Each Frame&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every screen refresh during the 1 s response window&amp;#10;#               (~120 polls at 120 Hz).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. Keeps the trigger pixel black (nothing should be triggered here)&amp;#10;#   2. Samples both clocks (PsychoPy + VPIXX) at this flip, so any key&amp;#10;#      events captured on this frame can be tagged with an approximate&amp;#10;#      VPIXX-clock timestamp (within one video frame of the real press)&amp;#10;#   3. Drains new keyboard events into trial_events&amp;#10;#   4. On ESC, ends the routine early (user abort)&amp;#10;#&amp;#10;# WHY THE VP TIMESTAMP IS &quot;_vp_est&quot; and not &quot;_vp&quot;:&amp;#10;#   VPIXX does NOT see the keyboard directly; the keyboard event lives&amp;#10;#   purely in the OS HID pipeline. We can't ask VPIXX &quot;when did this&amp;#10;#   press happen&quot; the way we can for a tone or trigger. So we estimate:&amp;#10;#   at this frame's flip we know both frame_pp (PsychoPy time of the&amp;#10;#   flip) and frame_vp (VPIXX time of the flip). For a key event with&amp;#10;#   PsychoPy-time key.tDown, its VPIXX time is approximately:&amp;#10;#       frame_vp + (key.tDown - frame_pp)&amp;#10;#   Accurate to ~1 video frame (8.3 ms at 120 Hz). The definitive&amp;#10;#   response time for MEG analysis should come from the button box's&amp;#10;#   TTL output wired into the MEG amplifier trigger channel, not from&amp;#10;#   this estimate.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   kb, KEY_CODES, EXIT_KEY, trial_events  - responseClassifySetup&amp;#10;#                                             (instruct Begin Experiment)&amp;#10;#   dp, DUMMY_VPIXX                         - vpixxSetup&amp;#10;#   setTriggerPixel, TRIG_OFF               - triggerSetup&amp;#10;#   core                                    - PsychoPy (always available)&amp;#10;#   globalClock                             - Builder: experiment-wide clock&amp;#10;#   frameN                                  - Builder: frame index&amp;#10;# ======================================================================&amp;#10;&amp;#10;setTriggerPixel(TRIG_OFF)&amp;#10;&amp;#10;# Sample both clocks at this flip for PP&lt;-&gt;VP conversion.&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    frame_vp = dp.DPxGetTime()&amp;#10;else:&amp;#10;    frame_vp = 0.0&amp;#10;frame_pp = globalClock.getTime() if 'globalClock' in dir() else core.getTime()&amp;#10;&amp;#10;# Drain any new key presses since the last poll.&amp;#10;keyList = list(KEY_CODES.keys()) + [EXIT_KEY]&amp;#10;new_keys = kb.getKeys(keyList=keyList, waitRelease=False)&amp;#10;for key in new_keys:&amp;#10;    if key.name == EXIT_KEY:&amp;#10;        # User abort: end this routine now. (The outer flow may&amp;#10;        # continue; use Ctrl-C in the Runner for a hard quit.)&amp;#10;        continueRoutine = False&amp;#10;        break&amp;#10;    label = KEY_CODES.get(key.name)&amp;#10;    if label is None:&amp;#10;        continue   # key not in our mapping; ignore&amp;#10;    trial_events.append({&amp;#10;        'kind':        'press',&amp;#10;        'label':       label,&amp;#10;        'key_name':    key.name,&amp;#10;        'time_pp':     key.tDown,&amp;#10;        'time_vp_est': frame_vp + (key.tDown - frame_pp),&amp;#10;    })&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;End Routine&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the 1 s response window ends.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. Classifies the trial outcome. Finds the FIRST press whose&amp;#10;#      PsychoPy-clock time falls in the scoring window&amp;#10;#      [deviant + 150 ms, deviant + 1400 ms]. If that press was on the&amp;#10;#      cued finger -&gt; 'correct'; different finger -&gt; 'wrong_button';&amp;#10;#      no in-window press -&gt; 'miss' (initialized that way in&amp;#10;#      trialSetupCode).&amp;#10;#   2. Also computes RT in both clocks:&amp;#10;#        rt_pp    = response_time_pp - deviant_onset_pp&amp;#10;#        rt_vp_est = response_time_vp_est - deviant_onset_vp&amp;#10;#      (rt_vp_est is approximate; see &quot;_vp_est&quot; rationale in Each Frame)&amp;#10;#   3. Logs EVERY detected key event (not just the scored one) to the&amp;#10;#      presses TSV so you can see out-of-window presses later.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   trial_events                        - Each Frame tab (this component)&amp;#10;#                                          and Begin Routine pre-drain&amp;#10;#   resp_min_pp, resp_max_pp            - Begin Routine (this component)&amp;#10;#   deviant_onset_pp, deviant_onset_vp  - tonePresent End Routine&amp;#10;#   cue_hand                            - conditions CSV&amp;#10;#   response_button, response_key_name,&amp;#10;#   response_time_pp, response_time_vp_est,&amp;#10;#   rt_pp, rt_vp_est, outcome           - trialSetupCode defaults&amp;#10;#   presses_log_rows                    - logFilesSetup Begin Experiment&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1 &amp; 2. Classify + compute RT (first in-window press only) ------&amp;#10;for ev in trial_events:&amp;#10;    if resp_min_pp &lt;= ev['time_pp'] &lt;= resp_max_pp:&amp;#10;        response_button      = ev['label']&amp;#10;        response_key_name    = ev['key_name']&amp;#10;        response_time_pp     = ev['time_pp']&amp;#10;        response_time_vp_est = ev['time_vp_est']&amp;#10;        rt_pp = response_time_pp - deviant_onset_pp&amp;#10;        if deviant_onset_vp is not None and ev['time_vp_est'] is not None:&amp;#10;            rt_vp_est = response_time_vp_est - deviant_onset_vp&amp;#10;        expected_finger = {'left': 'left_index', 'right': 'right_index'}[cue_hand]&amp;#10;        outcome = 'correct' if response_button == expected_finger else 'wrong_button'&amp;#10;        break   # first in-window press defines the response&amp;#10;&amp;#10;# ---- 3. Log every detected event (in or out of window) --------------&amp;#10;for ev in trial_events:&amp;#10;    presses_log_rows.append({&amp;#10;        'overall_trial': overall_trial,&amp;#10;        'block':         block_label,&amp;#10;        'label':         ev['label'],&amp;#10;        'key_name':      ev['key_name'],&amp;#10;        'time_pp':       '%.6f' % ev['time_pp'],&amp;#10;        'time_vp_est':   '' if ev['time_vp_est'] is None&amp;#10;                            else '%.6f' % ev['time_vp_est'],&amp;#10;    })&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="responseClassify" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="response_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="2" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="response_fixation_cross" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(32, 32)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="RESPONSE_WINDOW" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
    </Routine>
    <Routine name="feedback">
      <RoutineSettingsComponent name="feedback" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="feedback" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="outcome == 'correct'" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="FEEDBACK_DURATION" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="feedbackSelect" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# feedbackSelect  |  &quot;Begin Routine&quot; tab  |  routine: feedback&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of the feedback phase, but only on&amp;#10;#               error trials. The ROUTINE's skipIf field is&amp;#10;#               $outcome == 'correct', so Builder skips the entire&amp;#10;#               feedback routine on correct trials -- this code never&amp;#10;#               runs for them, and the trial goes straight from the&amp;#10;#               response window to BLINK.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. Picks the feedback TEXT and FONT HEIGHT based on outcome:&amp;#10;#        'miss'         -&gt; 'MISS'         (height 80 px)&amp;#10;#        'wrong_button' -&gt; 'WRONG BUTTON' (height 60 px)&amp;#10;#      These heights match the Coder script's feedback_miss / wrong&amp;#10;#      stims so the Builder version looks identical.&amp;#10;#   2. Sends the FEEDBACK trigger (32) on the next flip&amp;#10;#   3. Sets feedback_shown=True so trialLog records that feedback was&amp;#10;#      displayed on this trial (useful for later behavioural checks)&amp;#10;#&amp;#10;# The feedback_text TextComponent in this routine actually draws the&amp;#10;# text, using $feedback_text and $feedback_height (both &quot;set every&amp;#10;# repeat&quot;) so each trial gets the right message. Letting Builder's&amp;#10;# own render loop handle the drawing is more reliable than drawing&amp;#10;# imperatively from Each Frame code.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   outcome                  - responseClassify End Routine&amp;#10;#   sendTrigger, TRIG_FEEDBACK - triggerSetup (instruct routine)&amp;#10;#   feedback_shown           - trialSetupCode (initialised False)&amp;#10;# ======================================================================&amp;#10;&amp;#10;if outcome == 'miss':&amp;#10;    feedback_text   = 'MISS'&amp;#10;    feedback_height = 80&amp;#10;else:  # outcome == 'wrong_button' (correct is skipped before we get here)&amp;#10;    feedback_text   = 'WRONG BUTTON'&amp;#10;    feedback_height = 60&amp;#10;&amp;#10;sendTrigger(TRIG_FEEDBACK, 'feedback')&amp;#10;feedback_shown = True&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# feedbackSelect  |  &quot;Each Frame&quot; tab  |  routine: feedback&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Only runs on error trials (routine is skipped on correct). On the&amp;#10;# frame after the trigger pixel went high, blank it so the FEEDBACK&amp;#10;# trigger pulse is one frame long.&amp;#10;# ======================================================================&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="feedbackSelect" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="feedback_text_stim" plugin="None">
        <Param val="red" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="feedback_height" valType="code" updates="set every repeat" name="letterHeight"/>
        <Param val="feedback_text_stim" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="num" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="FEEDBACK_DURATION" valType="num" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$feedback_text" valType="str" updates="set every repeat" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1500" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
    <Routine name="blink">
      <RoutineSettingsComponent name="blink" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="blink" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="BLINK_DURATION" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="blinkPresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# blinkPresent  |  &quot;Begin Routine&quot; tab  |  routine: blink&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of each trial's BLINK phase (500 ms).&amp;#10;#               This phase is a controlled window for the subject to&amp;#10;#               blink without contaminating neural data from the&amp;#10;#               trial's main events.&amp;#10;#&amp;#10;# WHAT IT DOES: sends the BLINK trigger (4) on the next flip so the&amp;#10;#               MEG recording has a clear marker of when the subject&amp;#10;#               was allowed to blink. The TextComponent in this routine&amp;#10;#               draws the word &quot;BLINK&quot; so the subject knows it's OK.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   sendTrigger, TRIG_BLINK  - triggerSetup (instruct routine)&amp;#10;# ======================================================================&amp;#10;sendTrigger(TRIG_BLINK, 'blink')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# blinkPresent  |  &quot;Each Frame&quot; tab  |  routine: blink&amp;#10;# ----------------------------------------------------------------------&amp;#10;# One-frame trigger pulse: blank the pixel from frame 1 onward.&amp;#10;# ======================================================================&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# blinkPresent  |  &quot;End Routine&quot; tab  |  routine: blink&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Save BLINK onset times for the trial log.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   blink.tStartRefresh - Builder: PP time of this routine's first flip&amp;#10;#   vpixxTimes          - triggerSetup Begin Experiment (dict filled by&amp;#10;#                          recordVpixxTime, called via win.callOnFlip)&amp;#10;# ======================================================================&amp;#10;blink_onset_pp = blink.tStartRefresh&amp;#10;blink_onset_vp = vpixxTimes.get('blink')&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="blinkPresent" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="blink_text_stim" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="60" valType="num" updates="constant" name="letterHeight"/>
        <Param val="blink_text_stim" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="num" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="BLINK_DURATION" valType="num" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="BLINK" valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1500" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
    <Routine name="trialLog">
      <RoutineSettingsComponent name="trialLog" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trialLog" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="trialLogWrite" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# trialLogWrite  |  &quot;End Routine&quot; tab  |  routine: trialLog&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial, after all other per-trial&amp;#10;#               routines have finished.&amp;#10;#&amp;#10;# WHAT IT DOES: writes exactly one row to each of the three TSV files:&amp;#10;#               trial row (behavioural outcome + all timestamps),&amp;#10;#               per-tone rows (one per tone played this trial), and&amp;#10;#               per-press rows (one per detected keyboard event).&amp;#10;#               Flushes everything to disk so a mid-session crash&amp;#10;#               doesn't lose completed trials.&amp;#10;#&amp;#10;# TWO FORMATTING HELPERS (defined fresh here each trial):&amp;#10;#   _fmt_pp(val) - format a PsychoPy-clock value, or '' if None&amp;#10;#   _fmt_vp(val) - format a VPIXX-clock value, '' if None OR if we're&amp;#10;#                   in dummy mode (vpixxTimes always returns None then)&amp;#10;# ======================================================================&amp;#10;&amp;#10;&amp;#10;def _fmt_pp(val, p=6):&amp;#10;    return '' if val is None else ('%.*f' % (p, val))&amp;#10;&amp;#10;&amp;#10;def _fmt_vp(val, p=6):&amp;#10;    # Blank in dummy mode (vpixxTimes stores None then anyway, but we&amp;#10;    # also want a visually clean &quot;this was a dummy run&quot; indicator).&amp;#10;    if DUMMY_VPIXX or val is None:&amp;#10;        return ''&amp;#10;    return '%.*f' % (p, val)&amp;#10;&amp;#10;&amp;#10;_fixation_pp = fixation.tStartRefresh if hasattr(fixation, 'tStartRefresh') else None&amp;#10;_fixation_vp = vpixxTimes.get('fixation')&amp;#10;&amp;#10;trials_log_writer.writerow({&amp;#10;    'overall_trial':        overall_trial,&amp;#10;    'block':                block_label,&amp;#10;    'trial_in_block':       trial_in_block,&amp;#10;    'is_training':          is_training_bool,&amp;#10;    'cue_hand':             cue_hand,&amp;#10;    'expected_button':      expected_button,&amp;#10;    'n_standards':          n_standards,&amp;#10;    'fixation_onset_pp':    _fmt_pp(_fixation_pp),&amp;#10;    'fixation_onset_vp':    _fmt_vp(_fixation_vp),&amp;#10;    'cue_onset_pp':         _fmt_pp(cue_onset_pp),&amp;#10;    'cue_onset_vp':         _fmt_vp(vpixxTimes.get('cue')),&amp;#10;    'first_tone_onset_pp':  _fmt_pp(first_tone_onset_pp),&amp;#10;    'first_tone_onset_vp':  _fmt_vp(first_tone_onset_vp),&amp;#10;    'deviant_onset_pp':     _fmt_pp(deviant_onset_pp),&amp;#10;    'deviant_onset_vp':     _fmt_vp(deviant_onset_vp),&amp;#10;    'response_button':      response_button,&amp;#10;    'response_key_name':    response_key_name,&amp;#10;    'response_time_pp':     _fmt_pp(response_time_pp),&amp;#10;    'response_time_vp_est': _fmt_vp(response_time_vp_est),&amp;#10;    'rt_pp':                '' if (rt_pp != rt_pp) else '%.4f' % rt_pp,&amp;#10;    'rt_vp_est':            '' if (DUMMY_VPIXX or rt_vp_est != rt_vp_est) else '%.4f' % rt_vp_est,&amp;#10;    'outcome':              outcome,&amp;#10;    'feedback_shown':       feedback_shown,&amp;#10;    'blink_onset_pp':       _fmt_pp(blink_onset_pp),&amp;#10;    'blink_onset_vp':       _fmt_vp(blink_onset_vp),&amp;#10;    'dummy_vpixx':          DUMMY_VPIXX,&amp;#10;})&amp;#10;&amp;#10;for row in tones_log_rows:&amp;#10;    tones_log_writer.writerow(row)&amp;#10;tones_log_rows.clear()&amp;#10;&amp;#10;for row in presses_log_rows:&amp;#10;    presses_log_writer.writerow(row)&amp;#10;presses_log_rows.clear()&amp;#10;&amp;#10;# Keep running tallies for the end-of-experiment summary&amp;#10;if is_training_bool:&amp;#10;    training_results.append(outcome)&amp;#10;else:&amp;#10;    main_results.append((block_label, outcome))&amp;#10;&amp;#10;# Flush to disk after every trial (crash-safe)&amp;#10;for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;    _fh.flush()&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialLogWrite" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="trainingTransition">
      <RoutineSettingsComponent name="trainingTransition" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trainingTransition" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="trainingTransitionText" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# trainingTransitionText  |  &quot;Begin Routine&quot; tab  |  routine: trainingTransition&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the training block ends and before the&amp;#10;#               first main block starts.&amp;#10;#&amp;#10;# WHAT IT DOES: computes the subject's training-block accuracy and&amp;#10;#               builds a message that includes it, so the experimenter&amp;#10;#               can decide whether the subject is ready. The message&amp;#10;#               is displayed by the transitionDisplay TextComponent in&amp;#10;#               this routine (its text field is $transition_text).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   training_results - logFilesSetup Begin Experiment (list of outcome&amp;#10;#                      strings, appended at trialLog End Routine)&amp;#10;# ======================================================================&amp;#10;&amp;#10;_n_training = len(training_results)&amp;#10;_n_correct  = sum(1 for o in training_results if o == 'correct')&amp;#10;_pct = 100.0 * _n_correct / _n_training if _n_training &gt; 0 else 0.0&amp;#10;&amp;#10;transition_text = (&amp;#10;    'Training complete.\n\n'&amp;#10;    'Correct: %d/%d (%.1f%%)\n\n'&amp;#10;    'The main experiment will now begin.\n\n'&amp;#10;    'Experimenter: press SPACE to start the main experiment.'&amp;#10;) % (_n_correct, _n_training, _pct)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trainingTransitionText" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="transitionDisplay" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
