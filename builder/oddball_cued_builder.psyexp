        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# pixelModeOn  |  &quot;Begin Routine&quot; tab  |  routine: triggersOn&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, straight after the drift check, before the first&amp;#10;#               trial.&amp;#10;#&amp;#10;# WHAT IT DOES: switches the DATAPixx3's Pixel Mode B on. From now on&amp;#10;#               the top-left pixel's blue value goes to the MEG trigger&amp;#10;#               lines on every screen refresh.&amp;#10;# ======================================================================&amp;#10;setTriggerPixel(TRIG_OFF)            # start with the pixel black&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxEnableDoutPixelModeB()&amp;#10;    dp.DPxWriteRegCache()&amp;#10;    logging.exp('VPixx Pixel Mode B ON')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="pixelModeOn" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>

    <Routine name="trialSetup">
      <RoutineSettingsComponent name="trialSetup" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="trialSetup" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="trialSetupCode" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Begin Routine&quot; tab  |  routine: trialSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial, after Builder has set the&amp;#10;#               row's columns as local variables (cue_hand,&amp;#10;#               expected_button, n_standards, isis_json).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. parses this trial's ISI list&amp;#10;#   2. sets the tone_loop's nReps so it iterates n_standards + 1 times&amp;#10;#   3. figures out whether this is a training or main trial&amp;#10;#   4. clears per-trial state carried in triggerSetup's vpixxTimes dict&amp;#10;# ======================================================================&amp;#10;&amp;#10;import json&amp;#10;&amp;#10;# ---- 1. Parse the per-tone ISI list ---------------------------------&amp;#10;# isis_json is a JSON-encoded list of length n_standards (one gap after&amp;#10;# each standard; the deviant has no gap after it, it's the last tone).&amp;#10;isi_list = json.loads(isis_json)&amp;#10;&amp;#10;# ---- 2. Set tone_loop iteration count -------------------------------&amp;#10;# tone_loop reads this each time it starts (before its first iteration)&amp;#10;# because its nReps field is $tone_loop_reps. n_standards is the number&amp;#10;# of standards BEFORE the deviant; +1 adds the deviant itself.&amp;#10;tone_loop_reps = int(n_standards) + 1&amp;#10;&amp;#10;# ---- 3. Training vs main --------------------------------------------&amp;#10;# `is_training` comes in as a column of the conditions CSV: True in&amp;#10;# the training CSV, False in the three block CSVs. Builder loads it&amp;#10;# as a local variable for each trial. Convert to a real bool in case&amp;#10;# Builder keeps it as the string 'True'/'False'.&amp;#10;is_training = str(is_training) == 'True'&amp;#10;&amp;#10;# ---- 4. Fresh per-trial state ---------------------------------------&amp;#10;vpixxTimes.clear()&amp;#10;tone_index_in_trial = 0          # 0-indexed, bumped before each tone&amp;#10;first_tone_onset_pp = None&amp;#10;first_tone_onset_vp = None&amp;#10;deviant_onset_pp    = None&amp;#10;deviant_onset_vp    = None&amp;#10;&amp;#10;# Response fields default to 'no press'&amp;#10;response_button    = ''&amp;#10;response_key_name  = ''&amp;#10;response_time_pp   = None&amp;#10;response_time_vp_est = None&amp;#10;rt_pp              = float('nan')&amp;#10;rt_vp_est          = float('nan')&amp;#10;outcome            = 'miss'&amp;#10;feedback_shown     = False&amp;#10;&amp;#10;# Running trial counter (incremented in sequenceGen; here we bump it)&amp;#10;overall_trial += 1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialSetupCode" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="blockControl" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# blockControl  |  &quot;Begin Routine&quot; tab  |  routine: trialSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Sets block_label and trial_in_block for the trialLog based on which&amp;#10;# outer loop is active (is_training comes from the conditions CSV).&amp;#10;# ======================================================================&amp;#10;if is_training:&amp;#10;    block_label    = 'training'&amp;#10;    trial_in_block = training_trials.thisN + 1&amp;#10;else:&amp;#10;    block_label    = 'block_%d' % (block_loop.thisN + 1)&amp;#10;    trial_in_block = block_trials.thisN + 1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="blockControl" valType="code" updates="None" name="name" />
      </CodeComponent>
    </Routine>

    <Routine name="fixation">
      <RoutineSettingsComponent name="fixation" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="fixation" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="fixationTriggerClear" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# Clear any lingering trigger pixel.&amp;#10;setTriggerPixel(TRIG_OFF)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="fixationTriggerClear" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="2" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="fixation_cross" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(32, 32)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="FIXATION_DURATION" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
    </Routine>

    <Routine name="cue">
      <RoutineSettingsComponent name="cue" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="cue" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="cuePresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;Begin Routine&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial's cue phase.&amp;#10;#&amp;#10;# WHAT IT DOES: picks the correct arrow pair and sends the cue trigger&amp;#10;#               on the next refresh. The fixation cross is drawn by the&amp;#10;#               fixation PolygonComponent in this routine.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if cue_hand == 'left':&amp;#10;    cue_arrows_to_draw = cue_left_arrows&amp;#10;    sendTrigger(TRIG_CUE_LEFT, 'cue')&amp;#10;else:&amp;#10;    cue_arrows_to_draw = cue_right_arrows&amp;#10;    sendTrigger(TRIG_CUE_RIGHT, 'cue')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;Each Frame&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every frame during the cue (~60 frames at 120 Hz over&amp;#10;#               500 ms).&amp;#10;#&amp;#10;# WHAT IT DOES: draws the two cue arrows on top of the fixation cross.&amp;#10;#               The trigger pixel we coloured in Begin Routine goes&amp;#10;#               black again on frame 2 (one-frame trigger).&amp;#10;# ======================================================================&amp;#10;&amp;#10;# Draw arrows every frame while the cue routine is active&amp;#10;for a in cue_arrows_to_draw:&amp;#10;    a.draw()&amp;#10;&amp;#10;# After the first frame (where sendTrigger armed the pixel), set it&amp;#10;# back to OFF so the trigger is one frame long.&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# cuePresent  |  &quot;End Routine&quot; tab  |  routine: cue&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Save when the cue appeared (PsychoPy clock) for the trial log.&amp;#10;# ======================================================================&amp;#10;cue_onset_pp = cue.tStartRefresh&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="cuePresent" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="cue_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="2" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="cue_fixation_cross" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(32, 32)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="CUE_DURATION" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
    </Routine>

    <Routine name="tone">
      <RoutineSettingsComponent name="tone" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="tone" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="tonePresent" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;Begin Routine&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once at the start of every tone (standard or deviant),&amp;#10;#               inside tone_loop.&amp;#10;#&amp;#10;# WHAT IT DOES: configures the audio schedule and sends the right&amp;#10;#               trigger. The actual &quot;start audio&quot; command is in Each&amp;#10;#               Frame, on the frame tone first draws, so that audio&amp;#10;#               and trigger-pixel land on the same vsync.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   tone_loop_training / tone_loop_main - Builder: there are two&amp;#10;#     separate tone loops (one inside each outer loop) with different&amp;#10;#     names, so we pick the one that's actually iterating based on the&amp;#10;#     is_training flag from the conditions CSV.&amp;#10;#   tone_loop_reps  - trialSetup: n_standards + 1.&amp;#10;#   prep_tone_schedule, dummySounds - toneSetup.&amp;#10;#   dp, DUMMY_VPIXX - vpixxSetup.&amp;#10;# ======================================================================&amp;#10;&amp;#10;_active_tone_loop = tone_loop_training if is_training else tone_loop_main&amp;#10;tone_index_in_trial = _active_tone_loop.thisN   # 0, 1, 2, ..., n_standards&amp;#10;is_deviant = (tone_index_in_trial == tone_loop_reps - 1)&amp;#10;kind = 'deviant' if is_deviant else 'standard'&amp;#10;&amp;#10;# ---- Prep the audio schedule ---------------------------------------&amp;#10;# This loads config onto the device but does NOT start it. The start&amp;#10;# command goes out in Each Frame, synced to the first flip.&amp;#10;prep_tone_schedule(kind)&amp;#10;&amp;#10;# ---- Set the trigger colour for this tone --------------------------&amp;#10;if is_deviant:&amp;#10;    sendTrigger(TRIG_DEVIANT, 'tone_%d' % (tone_index_in_trial + 1))&amp;#10;else:&amp;#10;    sendTrigger(TRIG_STANDARD, 'tone_%d' % (tone_index_in_trial + 1))&amp;#10;&amp;#10;# For dummy mode (no DATAPixx3), queue the PsychoPy sound to play on&amp;#10;# the next flip.&amp;#10;if DUMMY_VPIXX:&amp;#10;    _dummy_stim = deviantSound if is_deviant else standardSound&amp;#10;    _dummy_stim.stop()&amp;#10;    win.callOnFlip(_dummy_stim.play)&amp;#10;&amp;#10;# One-flag so Each Frame fires the DATAPixx3 &quot;start&quot; exactly once.&amp;#10;tone_audio_started = False&amp;#10;&amp;#10;# This tone's PsychoPy clock onset, filled in Each Frame after the flip.&amp;#10;tone_onset_pp_this = None&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;Each Frame&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every frame during this tone's routine (~48 frames at&amp;#10;#               120 Hz for a 400 ms tone).&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   - On frame 0 (just BEFORE the first screen refresh): arms the&amp;#10;#     DATAPixx3 to start the audio schedule at that refresh. Nothing&amp;#10;#     may call DPxUpdateRegCache or DPxWriteRegCache between here and&amp;#10;#     the refresh, or the pending start will be erased.&amp;#10;#   - On frame 1 (after the first refresh): clears the trigger pixel&amp;#10;#     so the trigger lasts exactly one frame.&amp;#10;#   - Records this tone's VPIXX-clock onset into tone_onset_pp_this.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not tone_audio_started and frameN == 0:&amp;#10;    if not DUMMY_VPIXX:&amp;#10;        # IMPORTANT: must be the LAST VPixx commands before the next&amp;#10;        # win.flip(). Anything that calls DPxUpdateRegCache or&amp;#10;        # DPxWriteRegCache between here and the refresh would clobber&amp;#10;        # the pending start.&amp;#10;        dp.DPxStartAudSched()&amp;#10;        dp.DPxWriteRegCacheAfterVideoSync()&amp;#10;    tone_audio_started = True&amp;#10;&amp;#10;# One frame after the trigger pixel was coloured, blank it so the&amp;#10;# trigger is one frame long (~8.3 ms at 120 Hz).&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# tonePresent  |  &quot;End Routine&quot; tab  |  routine: tone&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of each tone's routine, after its full&amp;#10;#               (tone + ISI) duration.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   - captures this tone's PsychoPy and VPIXX onset times&amp;#10;#   - stores first-tone and deviant timestamps for the trial log&amp;#10;#   - appends one row per tone to the per-tone log file&amp;#10;# ======================================================================&amp;#10;&amp;#10;tone_onset_pp_this = tone.tStartRefresh&amp;#10;tone_onset_vp_this = vpixxTimes.get('tone_%d' % (tone_index_in_trial + 1))&amp;#10;&amp;#10;if tone_index_in_trial == 0:&amp;#10;    first_tone_onset_pp = tone_onset_pp_this&amp;#10;    first_tone_onset_vp = tone_onset_vp_this&amp;#10;&amp;#10;if is_deviant:&amp;#10;    deviant_onset_pp = tone_onset_pp_this&amp;#10;    deviant_onset_vp = tone_onset_vp_this&amp;#10;&amp;#10;tones_log_rows.append({&amp;#10;    'overall_trial':  overall_trial,&amp;#10;    'block':          block_label,&amp;#10;    'trial_in_block': trial_in_block,&amp;#10;    'tone_index':     tone_index_in_trial + 1,&amp;#10;    'kind':           kind,&amp;#10;    'frequency_hz':   deviantFreqHz if is_deviant else standardFreqHz,&amp;#10;    'onset_pp':       '%.6f' % tone_onset_pp_this,&amp;#10;    'onset_vp':       '' if tone_onset_vp_this is None else '%.6f' % tone_onset_vp_this,&amp;#10;})&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="tonePresent" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="tone_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="2" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="tone_fixation_cross" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(32, 32)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="TONE_DURATION + (isi_list[tone_index_in_trial] if tone_index_in_trial &lt; len(isi_list) else 0.0)" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
    </Routine>

    <Routine name="response_window">
      <RoutineSettingsComponent name="response_window" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="response_window" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="responseClassify" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;Begin Routine&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of the 1 s response window after the&amp;#10;#               deviant tone.&amp;#10;#&amp;#10;# WHAT IT DOES: resets the per-trial event buffer and clears any stale&amp;#10;#               keys from the keyboard. The scoring window boundaries&amp;#10;#               are set relative to the deviant onset captured in the&amp;#10;#               tone loop.&amp;#10;# ======================================================================&amp;#10;&amp;#10;trial_events = []&amp;#10;kb.clearEvents()&amp;#10;&amp;#10;# Scoring window boundaries (PsychoPy clock, from the deviant onset)&amp;#10;if deviant_onset_pp is None:&amp;#10;    # Shouldn't happen but be safe&amp;#10;    resp_min_pp = float('inf')&amp;#10;    resp_max_pp = float('inf')&amp;#10;else:&amp;#10;    resp_min_pp = deviant_onset_pp + RESP_WIN_MIN&amp;#10;    resp_max_pp = deviant_onset_pp + RESP_WIN_MAX&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;Each Frame&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: every frame of the 1 s response window (~120 polls).&amp;#10;#&amp;#10;# WHAT IT DOES: drains new keyboard events into trial_events, tagged&amp;#10;#               with an estimated VPIXX-clock time (frame_vp + delta).&amp;#10;#               Keeps the trigger pixel black.&amp;#10;# ======================================================================&amp;#10;&amp;#10;setTriggerPixel(TRIG_OFF)&amp;#10;&amp;#10;# Sample both clocks at this flip; use them to convert press times&amp;#10;# (PsychoPy clock) into estimated VPIXX-clock time.&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    frame_vp = dp.DPxGetTime()&amp;#10;else:&amp;#10;    frame_vp = 0.0&amp;#10;frame_pp = globalClock.getTime() if 'globalClock' in dir() else core.getTime()&amp;#10;&amp;#10;keyList = list(KEY_CODES.keys()) + [EXIT_KEY]&amp;#10;new_keys = kb.getKeys(keyList=keyList, waitRelease=False)&amp;#10;for key in new_keys:&amp;#10;    if key.name == EXIT_KEY:&amp;#10;        # Abort: let the routine end; main-flow abort would be a bigger&amp;#10;        # change. For now we just end the routine.&amp;#10;        continueRoutine = False&amp;#10;        break&amp;#10;    label = KEY_CODES.get(key.name)&amp;#10;    if label is None:&amp;#10;        continue&amp;#10;    trial_events.append({&amp;#10;        'kind':        'press',&amp;#10;        'label':       label,&amp;#10;        'key_name':    key.name,&amp;#10;        'time_pp':     key.tDown,&amp;#10;        'time_vp_est': frame_vp + (key.tDown - frame_pp),&amp;#10;    })&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# responseClassify  |  &quot;End Routine&quot; tab  |  routine: response_window&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: when the 1 s window ends (either normally or on abort).&amp;#10;#&amp;#10;# WHAT IT DOES: classifies the first in-window press as the response;&amp;#10;#               sets outcome, response fields, rt_pp, rt_vp_est; logs&amp;#10;#               every event to presses_log_rows.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# Classify: first press whose time_pp falls in [resp_min_pp, resp_max_pp]&amp;#10;for ev in trial_events:&amp;#10;    if resp_min_pp &lt;= ev['time_pp'] &lt;= resp_max_pp:&amp;#10;        response_button    = ev['label']&amp;#10;        response_key_name  = ev['key_name']&amp;#10;        response_time_pp   = ev['time_pp']&amp;#10;        response_time_vp_est = ev['time_vp_est']&amp;#10;        rt_pp = response_time_pp - deviant_onset_pp&amp;#10;        if deviant_onset_vp is not None and ev['time_vp_est'] is not None:&amp;#10;            rt_vp_est = response_time_vp_est - deviant_onset_vp&amp;#10;        outcome = ('correct' if response_button == {'left': 'left_index',&amp;#10;                                                     'right': 'right_index'}[cue_hand]&amp;#10;                   else 'wrong_button')&amp;#10;        break   # first in-window press defines the response&amp;#10;&amp;#10;# Log every detected event to the presses CSV (not just the scored one)&amp;#10;for ev in trial_events:&amp;#10;    presses_log_rows.append({&amp;#10;        'overall_trial': overall_trial,&amp;#10;        'block':         block_label,&amp;#10;        'label':         ev['label'],&amp;#10;        'key_name':      ev['key_name'],&amp;#10;        'time_pp':       '%.6f' % ev['time_pp'],&amp;#10;        'time_vp_est':   '' if ev['time_vp_est'] is None&amp;#10;                            else '%.6f' % ev['time_vp_est'],&amp;#10;    })&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="responseClassify" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="response_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="2" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="response_fixation_cross" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(32, 32)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="RESPONSE_WINDOW" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
    </Routine>

    <Routine name="feedback">
      <RoutineSettingsComponent name="feedback" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="feedback" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="outcome == &apos;correct&apos;" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="feedbackSelect" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# feedbackSelect  |  &quot;Begin Routine&quot; tab  |  routine: feedback&amp;#10;# ----------------------------------------------------------------------&amp;#10;# This routine's skipIf field is $outcome == 'correct', so this code&amp;#10;# only runs when the subject missed or pressed the wrong button.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if outcome == 'miss':&amp;#10;    feedback_stim_to_draw = feedback_miss_stim&amp;#10;else:  # wrong_button&amp;#10;    feedback_stim_to_draw = feedback_wrong_stim&amp;#10;&amp;#10;sendTrigger(TRIG_FEEDBACK, 'feedback')&amp;#10;feedback_shown = True&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# Draw the feedback text each frame; clear the trigger after 1 frame.&amp;#10;feedback_stim_to_draw.draw()&amp;#10;if frameN &gt;= 1:&amp;#10;    setTriggerPixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="feedbackSelect" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="feedback_fixation_cross" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
