        <Param val="feedbackSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="blinkSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# blinkPresent  |  &quot;Begin Experiment&quot; tab  |  routine: blink&amp;#10;# ----------------------------------------------------------------------&amp;#10;# Creates the BLINK TextStim. White text, so the subject can see it.&amp;#10;# ======================================================================&amp;#10;&amp;#10;blink_text_stim = visual.TextStim(&amp;#10;    win, text='BLINK', color='white', height=60, bold=True, autoLog=False,&amp;#10;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="blinkSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="breakSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# breakControl  |  &quot;Begin Experiment&quot; tab  |  routine: breakScreen&amp;#10;# ----------------------------------------------------------------------&amp;#10;# INTERBLOCK_MIN_REST sets the forced-rest duration before SPACE is&amp;#10;# accepted (subject gets a real break; experimenter can't rush past).&amp;#10;# ======================================================================&amp;#10;INTERBLOCK_MIN_REST = 15.0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="breakSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialTimingSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Before Experiment&quot; tab  |  routine: trialSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets timing constants for every trial. Edit here to&amp;#10;#               change the paradigm's phase durations.&amp;#10;# ======================================================================&amp;#10;&amp;#10;FIXATION_DURATION   = 1.500      # s, fixation cross alone&amp;#10;CUE_DURATION        = 0.500      # s, arrows flanking fixation&amp;#10;RESPONSE_WINDOW     = 1.000      # s, fixation-only after last tone&amp;#10;FEEDBACK_DURATION   = 0.400      # s, MISS or WRONG BUTTON (errors only)&amp;#10;BLINK_DURATION      = 0.500      # s, 'BLINK' text&amp;#10;&amp;#10;# Response scoring window, in seconds AFTER deviant onset&amp;#10;RESP_WIN_MIN        = 0.150      # reject anticipatory presses&amp;#10;TONE_DURATION       = 0.400      # tone itself (needed below)&amp;#10;RESP_WIN_MAX        = TONE_DURATION + RESPONSE_WINDOW   # 1.400 s&amp;#10;&amp;#10;# Cue arrow geometry&amp;#10;CUE_ARROW_OFFSET_PX = 50         # distance from fixation to each arrow&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialTimingSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialLog" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;Begin Experiment&quot; tab  |  routine: trialLog&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: opens three TSV files (one row per trial, one row per&amp;#10;#               tone, one row per button press). Each row is flushed&amp;#10;#               to disk after it's written, so a crash doesn't lose&amp;#10;#               completed trials.&amp;#10;#&amp;#10;# COLUMN NAMING CONVENTION (clock provenance):&amp;#10;#   *_pp        PsychoPy default clock (behavioural RT reference)&amp;#10;#   *_vp        VPIXX DATAPixx3 hardware clock (MEG alignment reference)&amp;#10;#   *_vp_est    estimated VPIXX time (derived from a PsychoPy-clock&amp;#10;#               event via the PP&lt;-&gt;VP correspondence sampled at the&amp;#10;#               nearest flip). Accurate to ~one video frame.&amp;#10;# ======================================================================&amp;#10;&amp;#10;import csv as _csv&amp;#10;&amp;#10;_log_base = thisExp.dataFileName&amp;#10;&amp;#10;trials_log_path   = _log_base + '_trials_log.tsv'&amp;#10;tones_log_path    = _log_base + '_tones_log.tsv'&amp;#10;presses_log_path  = _log_base + '_presses_log.tsv'&amp;#10;&amp;#10;trials_log_columns = [&amp;#10;    'overall_trial', 'block', 'trial_in_block', 'is_training',&amp;#10;    'cue_hand', 'expected_button', 'n_standards',&amp;#10;    'fixation_onset_pp', 'fixation_onset_vp',&amp;#10;    'cue_onset_pp',      'cue_onset_vp',&amp;#10;    'first_tone_onset_pp', 'first_tone_onset_vp',&amp;#10;    'deviant_onset_pp',    'deviant_onset_vp',&amp;#10;    'response_button', 'response_key_name',&amp;#10;    'response_time_pp', 'response_time_vp_est',&amp;#10;    'rt_pp', 'rt_vp_est',&amp;#10;    'outcome', 'feedback_shown',&amp;#10;    'blink_onset_pp', 'blink_onset_vp',&amp;#10;    'dummy_vpixx',&amp;#10;]&amp;#10;&amp;#10;tones_log_columns = [&amp;#10;    'overall_trial', 'block', 'trial_in_block', 'tone_index',&amp;#10;    'kind', 'frequency_hz', 'onset_pp', 'onset_vp',&amp;#10;]&amp;#10;&amp;#10;presses_log_columns = [&amp;#10;    'overall_trial', 'block', 'label', 'key_name',&amp;#10;    'time_pp', 'time_vp_est',&amp;#10;]&amp;#10;&amp;#10;_trials_log_fh  = open(trials_log_path,  'w', newline='')&amp;#10;_tones_log_fh   = open(tones_log_path,   'w', newline='')&amp;#10;_presses_log_fh = open(presses_log_path, 'w', newline='')&amp;#10;&amp;#10;trials_log_writer  = _csv.DictWriter(_trials_log_fh,  fieldnames=trials_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;tones_log_writer   = _csv.DictWriter(_tones_log_fh,   fieldnames=tones_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;presses_log_writer = _csv.DictWriter(_presses_log_fh, fieldnames=presses_log_columns,&amp;#10;                                     delimiter='\t')&amp;#10;&amp;#10;trials_log_writer.writeheader()&amp;#10;tones_log_writer.writeheader()&amp;#10;presses_log_writer.writeheader()&amp;#10;&amp;#10;for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;    _fh.flush()&amp;#10;&amp;#10;# In-memory per-trial collectors. tone and response routines append&amp;#10;# here; trialLog writes them out at End Routine.&amp;#10;tones_log_rows   = []&amp;#10;presses_log_rows = []&amp;#10;&amp;#10;# Default values used by trialLog's End Routine&amp;#10;block_label      = 'training'   # overwritten in the main block loop&amp;#10;trial_in_block   = 0            # overwritten in each loop&amp;#10;&amp;#10;# Close the files when the program ends.&amp;#10;import atexit as _atexit_log&amp;#10;&amp;#10;&amp;#10;def _close_logs():&amp;#10;    for _fh in (_trials_log_fh, _tones_log_fh, _presses_log_fh):&amp;#10;        try:&amp;#10;            _fh.close()&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;&amp;#10;&amp;#10;_atexit_log.register(_close_logs)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialLog" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="taskStartMsg" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# taskStartMsg  |  &quot;End Routine&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: when the experimenter presses SPACE to leave the&amp;#10;#               instructions screen.&amp;#10;#&amp;#10;# WHAT IT DOES: writes TASK_START into the eye-tracking data file (EDF)&amp;#10;#               so the start of the task is easy to find in analysis.&amp;#10;# ======================================================================&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;el_tracker.sendMessage('TASK_START')&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="taskStartMsg" valType="code" updates="None" name="name" />
      </CodeComponent>
